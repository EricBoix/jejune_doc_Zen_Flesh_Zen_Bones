    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 121 ;
    neo:sentence_number 1 ;
    neo:text "This consciousness exists as each being, and nothing else exists."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5536 a neo:Document ;
