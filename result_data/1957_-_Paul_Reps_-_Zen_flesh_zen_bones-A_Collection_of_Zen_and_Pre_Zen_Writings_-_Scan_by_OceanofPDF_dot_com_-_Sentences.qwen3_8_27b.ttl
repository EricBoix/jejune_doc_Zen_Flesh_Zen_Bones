    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 4 ;
    neo:text "I see myriad worlds of the universe as small seeds of fruit, and the greatest lake in India as a drop of oil on my foot."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3462 a neo:Document ;
