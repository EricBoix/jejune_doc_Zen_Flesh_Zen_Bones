    neo:paragraph_number 8 ;
    neo:sentence_number 2 ;
    neo:text "Ryonen wrote a poem on the back of a little mirror:"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2094 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2095,
