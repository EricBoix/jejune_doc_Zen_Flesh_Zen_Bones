        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_582,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_826,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_827 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "12. Happy Chinaman"^^xsd:string ;
    neo:id "0e93d54349064a5b13c698b16ecb79c0"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 2 ;
    neo:text "And if anyone asked him to return to a temple to teach others, again he would reply: 'Give me one penny.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_828 a neo:Document ;
