        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1142 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "19. The First Principle"^^xsd:string ;
    neo:id "8285d6986fd75480c0b209b18c97c7f8"^^xsd:string ;
