    neo:text "He kept the precepts himself and expected his priests to do so."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_736 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_231,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_34,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_737,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_738 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "939d98f379178e5947aada949676843e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 3 ;
    neo:text "In modern Japan whatever zeal these priests have lost for Buddhism they seem to have gained for having wives."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_739 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_230,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_731,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_740,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_741 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "b47e8eb20ab3c8ea7242342b29c680f8"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 1 ;
    neo:text "Mokurai used to take a broom and chase the women away when he found them in any of his temples, but the more wives he swept out, the more seemed to come back."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_742 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_582,
