    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 5 ;
    neo:text "I perceive the teachings of the world to be the illusion of, magicians."^^xsd:string .

