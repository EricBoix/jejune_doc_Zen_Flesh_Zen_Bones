    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 3 ;
    neo:text "\"What does our teacher mean?\""^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3584 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_232,
