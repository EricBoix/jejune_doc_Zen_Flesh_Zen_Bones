    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 119 ;
    neo:sentence_number 3 ;
    neo:text "Then, leaving aside the object-feeling and the absence-feeling, realize."^^xsd:string .

