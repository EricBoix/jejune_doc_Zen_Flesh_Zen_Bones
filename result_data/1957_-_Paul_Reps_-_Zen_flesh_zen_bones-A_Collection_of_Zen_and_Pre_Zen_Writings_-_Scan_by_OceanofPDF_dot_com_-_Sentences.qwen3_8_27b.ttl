    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 2 ;
    neo:text "I was a Zen master and lived on this mountain."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3558 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1002,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1081,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3559,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_574 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "2. Hyakujo's Fox"^^xsd:string ;
    neo:id "fd4cdb333693e325e07cdcec19f19558"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 3 ;
    neo:text "At that time one of my students asked me whether or not the enlightened man is subject to the law of causation."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3560 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2435,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_293,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_320,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3561 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "2. Hyakujo's Fox"^^xsd:string ;
    neo:id "d67d733fe15e39ad67bbb30257590330"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 4 ;
    neo:text "I answered him: 'The enlightened man is not subject to the law of causation.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3562 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1598,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2946,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_320,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3563,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3564,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3565 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "2. Hyakujo's Fox"^^xsd:string ;
    neo:id "0415890191ef5d34a242ddecf2d27764"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 5 ;
    neo:text "For this answer evidencing a clinging to absoluteness I became a fox for five hundred rebirths, and I am still a fox."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3566 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_217,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2946,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_324,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3567 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "2. Hyakujo's Fox"^^xsd:string ;
    neo:id "a4f6d81154f3b323959245ca24f5e157"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 6 ;
    neo:text "Will you save me from this condition with your Zen words and let me get out of a fox's body?"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3568 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1002,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3559 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "2. Hyakujo's Fox"^^xsd:string ;
    neo:id "cfd05eda9a5e141b72dba9f9af8e0003"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 7 ;
    neo:text "Now may I ask you: Is the enlightened man subject to the law of causation?\""^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3569 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2435,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2987,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3561 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "2. Hyakujo's Fox"^^xsd:string ;
    neo:id "98ac9778061c173fbbe2d9855085a34f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "Hyakujo said: \"The enlightened man is one with the law of causation.\""^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3570 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1934,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2987 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "2. Hyakujo's Fox"^^xsd:string ;
    neo:id "927d3996cea4bd150aa89a7f8e301042"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 1 ;
    neo:text "At the words of Hyakujo the old man was enlightened."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3571 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1540,
