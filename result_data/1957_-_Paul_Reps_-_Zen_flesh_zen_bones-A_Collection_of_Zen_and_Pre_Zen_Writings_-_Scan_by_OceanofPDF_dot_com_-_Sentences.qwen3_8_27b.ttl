    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 4 ;
    neo:text "At last a sentence of seven years was completed, and Shunkai was released from the prison, where the sixty-three-year-old warden also had become enamored of her."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_765 a neo:Document ;
