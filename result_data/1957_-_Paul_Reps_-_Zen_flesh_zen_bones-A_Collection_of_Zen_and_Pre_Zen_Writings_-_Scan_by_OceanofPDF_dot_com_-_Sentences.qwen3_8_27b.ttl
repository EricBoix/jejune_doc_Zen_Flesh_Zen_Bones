    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "Sengai, inspecting the dormitory quarters, found this pupil missing one night and also discovered the high stool he had used to scale the wall."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3276 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2864,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3277 ;
