    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "30. This Mind Is Buddha"^^xsd:string ;
    neo:id "dd29fabf1796296a88dee56b7862ac45"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 1 ;
    neo:text "Under blue sky, in bright sunlight, One need not search around."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4358 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_111,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4359,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4360,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4361 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "30. This Mind Is Buddha"^^xsd:string ;
    neo:id "2adf7ab1be68a3110fc1d2d5cff047a6"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 2 ;
    neo:text "Asking what Buddha is Is like hiding loot in one's pocket and declaring oneself innocent."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4362 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2827,
