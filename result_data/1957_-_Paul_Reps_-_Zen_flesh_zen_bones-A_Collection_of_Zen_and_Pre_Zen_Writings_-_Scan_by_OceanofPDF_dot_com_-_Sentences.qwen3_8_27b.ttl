    neo:paragraph_number 11 ;
    neo:sentence_number 2 ;
    neo:text "inclusive) and the five skandas are No-things."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_840 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_111,
