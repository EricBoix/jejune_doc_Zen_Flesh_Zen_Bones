    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:sentence_number 3 ;
    neo:text "You serve humanity humbly, fulfilling your presence in this world with loving-kindness and observing your passing as a petal falling from a flower."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2181 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2182,
