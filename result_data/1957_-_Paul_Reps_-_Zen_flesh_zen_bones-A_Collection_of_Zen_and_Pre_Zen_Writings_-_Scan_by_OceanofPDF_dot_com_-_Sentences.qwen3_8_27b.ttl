    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "46. How Grass and Trees Become Enlightened"^^xsd:string ;
    neo:id "bb67c27b217a7e11dd9f3bceb65d3727"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "One day a fifty-year-old student of enlightenment said to Shinkan: 'I have studied the Tendai school of thought since I was a little boy, but one thing in it I cannot understand."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1923 a neo:Document ;
