    neo:paragraph_number 3 ;
    neo:sentence_number 2 ;
    neo:text "Give him an uppercut And you will be called one who understands Zen."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4467 a neo:Document ;
