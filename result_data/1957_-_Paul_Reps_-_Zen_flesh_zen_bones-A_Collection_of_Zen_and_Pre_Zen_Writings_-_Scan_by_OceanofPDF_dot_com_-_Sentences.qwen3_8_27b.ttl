        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_766 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "16. Not Far from Buddahood"^^xsd:string ;
    neo:id "5966a92bf42b8e012c5612bd6d26dea0"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 2 ;
    neo:text "For everyone that asketh receiveth, and he that seeketh findeth, and to him that knocketh, it shall be opened.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1012 a neo:Document ;
