    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 13 ;
    neo:sentence_number 2 ;
    neo:text "Each time I come here all you tell me is to take care of my patients."^^xsd:string .

