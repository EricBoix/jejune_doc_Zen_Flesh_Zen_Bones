    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 1 ;
    neo:text "The old woman said: \"I read that sutra which says: 'The past mind cannot be held, the present mind cannot be held, the future mind cannot be held.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4288 a neo:Document ;
