    neo:sentence_number 3 ;
    neo:text "Get me a gallon of fine wine and something good to eat."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3231 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254,
