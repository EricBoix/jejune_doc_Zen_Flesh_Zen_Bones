    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:sentence_number 1 ;
    neo:text "But his teacher commented: 'You are not in yet.'"^^xsd:string .

