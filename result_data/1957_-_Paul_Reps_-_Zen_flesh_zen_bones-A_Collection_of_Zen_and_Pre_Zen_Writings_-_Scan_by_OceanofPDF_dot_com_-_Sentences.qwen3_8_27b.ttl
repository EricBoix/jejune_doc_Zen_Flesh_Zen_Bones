        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_743,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_744 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "2ab414aa8a2ef7b32c2bdd35a36a8a00"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 1 ;
    neo:text "In this particular temple the wife of the head priest became jealous of Shunkai's earnestness and beauty."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_745 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_21,
