        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_923 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "84. True Friends"^^xsd:string ;
