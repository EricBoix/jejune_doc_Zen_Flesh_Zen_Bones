    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "Kyozan arose and, hitting the gavel, said: \"The truth of Mahayana teaching is transcendent, above words and thought."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4189 a neo:Document ;
