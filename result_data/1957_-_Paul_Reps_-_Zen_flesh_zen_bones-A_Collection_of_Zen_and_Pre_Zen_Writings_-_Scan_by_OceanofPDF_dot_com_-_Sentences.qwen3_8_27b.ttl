    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 3 ;
    neo:text "He told Dairyo: 'I insist on eating the same food as the least of my followers."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_214 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_215,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_216,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_217 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:id "44111ea061d886a806647d1dbe035941"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:sentence_number 2 ;
    neo:text "Neither illiberal attitudes nor egotistical actions trouble you."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2140 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_217,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_320,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_574 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "51. Sour Miso"^^xsd:string ;
    neo:id "3623deefff4065b8ede3644f13d06c20"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 4 ;
    neo:text "When you become the teacher I do not want you to forget this.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2141 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1081,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1312,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_46,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_737,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_980 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "52. Your Light may go out"^^xsd:string ;
    neo:id "c49a01a39bdf402fdf6535af0da9db26"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "A student of Tendai a philosophical school of Buddhism, came to the Zen abode of Gasan as a pupil."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2142 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1092,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2143,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2144,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_980 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "52. Your Light may go out"^^xsd:string ;
    neo:id "595e55d61bdf149e323a34f575070176"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "When he was departing a few years later, Gasan warned him: 'Studying the truth speculatively is useful as a way of collecting preaching material."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2145 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_180,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2146,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_217 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "52. Your Light may go out"^^xsd:string ;
    neo:id "1056d8dcfee89973d54c129b89dbb543"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 3 ;
    neo:text "But remember that unless you meditate constantly your light of truth may go out.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2147 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2148,
