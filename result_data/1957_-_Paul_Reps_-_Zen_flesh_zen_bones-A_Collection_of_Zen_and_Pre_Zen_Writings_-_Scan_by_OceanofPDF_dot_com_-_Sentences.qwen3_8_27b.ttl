    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:sentence_number 1 ;
    neo:text "Hoshin, with the roar of a conquering lion, shouted 'Kaa!'"^^xsd:string .

