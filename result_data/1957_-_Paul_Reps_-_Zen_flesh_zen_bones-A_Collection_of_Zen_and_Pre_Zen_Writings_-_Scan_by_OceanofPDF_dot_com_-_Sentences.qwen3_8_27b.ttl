        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_686 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "cea57783a8fcaf5b7b5f3d159fbf1ca6"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:sentence_number 2 ;
    neo:text "It is customary to write a farewell poem, but I am neither poet nor calligrapher."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_687 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_55,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_688,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_689 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "b869eadb0c6cc0e0b74e93d9c8eb516f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:sentence_number 3 ;
    neo:text "Let one of you inscribe my last words.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_69 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_57,
