        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_368 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "53. The Giver Should be Thankful"^^xsd:string ;
    neo:id "4c18fdf7cce0ab7aaf49f3e73bee8fe5"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 3 ;
    neo:text "This money he brought to the teacher."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2157 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2148,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2158 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "53. The Giver Should be Thankful"^^xsd:string ;
    neo:id "1a1928e827449fa7508c8358c631524c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "Seisetsu said: 'All right."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2159 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_161,
