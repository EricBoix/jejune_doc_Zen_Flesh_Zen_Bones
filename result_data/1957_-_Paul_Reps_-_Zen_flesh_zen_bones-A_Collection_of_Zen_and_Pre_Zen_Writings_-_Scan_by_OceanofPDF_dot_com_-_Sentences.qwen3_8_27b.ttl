    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:sentence_number 6 ;
    neo:text "He happened to stop near Ryutan's monastery for refreshments."^^xsd:string .

