        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4477 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "37. A Buffalo Passes Through the Enclosure"^^xsd:string ;
    neo:id "41b82475b3544846d9633ed3f0d022fd"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 2 ;
    neo:text "But if he cannot say such a word of true Zen, he should turn back to his tail."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4478 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4468,
