    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "40. Tipping Over a Water Vase"^^xsd:string ;
    neo:id "44e4bc166e0ba3a000c249dc1fc1792a"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 3 ;
    neo:text "Placing a water vase on the ground, he asked: \"Who can say what this is without calling its name?\""^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4518 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3579,
