    neo:h2 "10 BULLS"^^xsd:string ;
    neo:id "ad1bb71b51ca54164cb449c2e5fcff0d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "Transcribed by Nyogen Senzaki and Paul Reps"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1321 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1314,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1315,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1319,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1322,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_241 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "24. Reciting Sutras"^^xsd:string ;
    neo:id "206a8c2dfd76eee51d6dd97bd453328b"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "'If you say all sentient beings will benefit,' said the farmer, 'my wife may be very weak and others will take advantage of her, getting the benefit she should have."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1323 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_296,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_455 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "24. Reciting Sutras"^^xsd:string ;
    neo:id "767d3d1d3a97a367f59691174775038d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 2 ;
    neo:text "So please recite sutras just for her.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1324 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1317,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1325,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1326,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_478,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_854 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "24. Reciting Sutras"^^xsd:string ;
    neo:id "efd95e1e3a04fc64afc2374ce3aac68f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 1 ;
    neo:text "The priest explained that it was the desire of a Buddhist to offer blessings and wish merit for every living being."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1327 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1059,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1314,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1328 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "24. Reciting Sutras"^^xsd:string ;
    neo:id "81679cf1b2cdc6c4b57bd38497b07be3"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 1 ;
    neo:text "That is a fine teaching,' concluded the farmer, 'but please make one exception."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1329 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1330,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_320 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "24. Reciting Sutras"^^xsd:string ;
    neo:id "7a94baed5187ba766dc608284dbcb9c5"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 2 ;
    neo:text "I have a neighbor who is rough and mean to me."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_133 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_134,
