    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "Desiring to show his attainment, he said: The mind, Buddha, and sentient beings, after all, do not exist."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_297 a neo:Document ;
