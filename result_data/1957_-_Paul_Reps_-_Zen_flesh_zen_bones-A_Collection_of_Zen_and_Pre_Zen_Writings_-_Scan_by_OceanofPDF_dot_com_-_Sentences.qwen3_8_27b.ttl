    neo:sentence_number 2 ;
    neo:text "The birds sing among innumerable kinds of fragrant flowers.\""^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4165 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3485,
