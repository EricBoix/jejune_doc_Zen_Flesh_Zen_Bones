        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2346,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4351,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4352,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4353,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4354 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "30. This Mind Is Buddha"^^xsd:string ;
    neo:id "b6f0c71a973c38bcb6dc8f63fc25ea2d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 3 ;
    neo:text "If one truly understands, he will wash out his mouth for three days after saying the word Buddha, and he will close his ears and flee after hearing \"This mind is Buddha.\""^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4355 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1065,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4356,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4357,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_974 ;
