    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 6 ;
    neo:text "I am going to keep him here even if all the rest of you leave.'"^^xsd:string .

