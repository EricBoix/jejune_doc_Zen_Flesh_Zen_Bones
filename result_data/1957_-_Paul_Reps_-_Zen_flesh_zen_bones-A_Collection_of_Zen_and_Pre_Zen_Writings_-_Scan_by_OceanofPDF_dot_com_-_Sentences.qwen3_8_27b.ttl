    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 2 ;
    neo:text "\"I attained my finger-Zen,\" he said, \"from my teacher Tenryu, and in my whole life I could not exhaust it.\""^^xsd:string .

