    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "19. The First Principle"^^xsd:string ;
    neo:id "803bd08c536feee02d72ddcd1d464ea2"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 1 ;
    neo:text "Kosen patiently wrote one sheet after another until eighty-four First Principles had accumulated, still without the approval of the pupil."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1152 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1126,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1134,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_747 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "19. The First Principle"^^xsd:string ;
    neo:id "f9f9979e0153157da2690a29b5a6ee10"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:sentence_number 1 ;
    neo:text "Then, when the young man stepped outside for a few moments, Kosen thought: 'Now is my chance to escape his keen eye,' and he wrote hurriedly, with a mind free from distraction: 'The First principle.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1153 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1148,
