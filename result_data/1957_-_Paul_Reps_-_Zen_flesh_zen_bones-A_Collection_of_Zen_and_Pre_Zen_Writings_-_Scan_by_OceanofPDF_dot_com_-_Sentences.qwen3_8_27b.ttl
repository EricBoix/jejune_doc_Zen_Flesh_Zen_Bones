    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1730,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1731 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "39. Sleeping in the Dayime"^^xsd:string ;
    neo:id "fb5a677c0fe07887f3be269ed9bc6b32"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "The master Soya Shaku passed from this world when he was sixty-one years of age."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1732 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1059,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1733,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1734,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "39. Sleeping in the Dayime"^^xsd:string ;
    neo:id "0526a74cefa4eb31f05dad4d78e26e0e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "Fulfilling his life's work, he left a great teaching, far richer than that of most Zen masters."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1735 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1553,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1736,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_575,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_852 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "39. Sleeping in the Dayime"^^xsd:string ;
    neo:id "5d9db1cf71f919e2f7eb84c931c52fab"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 3 ;
    neo:text "His pupils used to sleep in the daytime during midsummer, and while he overlooked this he himself never wasted a minute."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1737 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1738,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "39. Sleeping in the Dayime"^^xsd:string ;
    neo:id "e618b545604cca7b15b88c622d1b0d87"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "When he was but twelve year old he was already studying Tendai philosophical speculation."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1739 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1740,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1741,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1742,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1743,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1744,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1745,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_574 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "39. Sleeping in the Dayime"^^xsd:string ;
    neo:id "0f3185d2395c483e1f2cadd2e2e3fa4d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 2 ;
    neo:text "One summer day the air had been so sultry that Little Soyen stretched his legs and went to sleep while his teacher was away."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1746 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1747,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "39. Sleeping in the Dayime"^^xsd:string ;
    neo:id "7859c34d8c000ba36795bb7cb2b90756"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "Three hours passed when, suddenly waking he hard his master enter, but it was too late."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1748 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1749,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "39. Sleeping in the Dayime"^^xsd:string ;
    neo:id "a070fe9556f0beb2773cfc18c28c11d4"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 2 ;
    neo:text "There he lay, sprawled across the doorway."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1750 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1751,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1752 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "39. Sleeping in the Dayime"^^xsd:string ;
    neo:id "4b6dcf9a9809f53783d76da140bc1441"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 1 ;
    neo:text "'I beg your pardon, I beg your pardon,' his teacher whispered, stepping carefully over Soyen's body as if it were that of some distinguished guest."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1753 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1752,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1754 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "39. Sleeping in the Dayime"^^xsd:string ;
    neo:id "833e27ec39dcabf633156624aa3ac7fb"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 2 ;
    neo:text "After this, Soyen never slept again in the afternoon."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1755 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1256,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1756,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1757 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "40. In Dreamland"^^xsd:string ;
    neo:id "af94043996bfbe19b7edbeceb1beba13"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "'Our schoolmaster used to take a nap every afternoon,' related a disciple of Soyen Shaku."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1758 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1759,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1760,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1761,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1762,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_293 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "40. In Dreamland"^^xsd:string ;
    neo:id "36a18daaa494bf6d05298ee17cbf0582"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "'We children asked him why he did it and he told us: 'I go to dreamland to meet the old sages just as Confucius did.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_176 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_177,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_178,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_46 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:id "0b81d8a99b8eb01bc4b5119791bee377"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:sentence_number 3 ;
    neo:text "Zen is not a sect but an experience."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1763 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1762,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1764,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1765 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "40. In Dreamland"^^xsd:string ;
    neo:id "62c3cc46f553016f1e07207a58e9c74c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 3 ;
    neo:text "When Confucius slept, he would dream of ancient sages and later tell his followers about them."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1766 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1767,
