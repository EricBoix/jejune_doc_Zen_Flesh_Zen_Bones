    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:sentence_number 4 ;
    neo:text "Zen, Shunkai found, was one thing and the followers of Zen quite another."^^xsd:string .

