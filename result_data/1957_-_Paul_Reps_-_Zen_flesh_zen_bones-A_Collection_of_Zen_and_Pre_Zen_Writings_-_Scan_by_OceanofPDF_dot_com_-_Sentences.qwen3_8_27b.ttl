    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 3 ;
    neo:text "As a wandering mendicant when he was twenty he happened to meet a traveler who smoked tobacco."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3367 a neo:Document ;
