    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 1 ;
    neo:text "The nun Soji said: 'In my view, it is like Ananda's sight of the Buddha- land--seen once and for ever.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_710 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_711,
