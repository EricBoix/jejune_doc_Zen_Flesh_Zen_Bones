    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "94. Midnight Excursion"^^xsd:string ;
    neo:id "4306e477545a19304e7d65e1d2049f14"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "When the wanderer returned, not knowing that Sengai was the stool he put his feet on the master's head and jumped down into the grounds."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_328 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_217,
