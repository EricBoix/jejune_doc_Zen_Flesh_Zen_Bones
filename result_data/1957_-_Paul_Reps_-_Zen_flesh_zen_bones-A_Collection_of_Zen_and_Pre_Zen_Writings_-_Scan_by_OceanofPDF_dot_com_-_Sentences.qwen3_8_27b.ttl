    neo:id "6742c3f381734df24f44429506da0225"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 2 ;
    neo:text "The elder brother, tired that day from much studying, told the younger one to take his place."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1388 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1389,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "26. Trading Dialogue for Lodging"^^xsd:string ;
    neo:id "718cf2a0ab0339640cb3110af0c9ca39"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 3 ;
    neo:text "'Go and request the dialogue in silence,' he cautioned."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1390 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1391,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1392,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1393 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "26. Trading Dialogue for Lodging"^^xsd:string ;
    neo:id "a8bad5e3aac43f39a469cad56259f4c1"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 1 ;
    neo:text "So the young monk and the strange went to the shrine and sat down."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1394 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1395,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1396,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1397 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "26. Trading Dialogue for Lodging"^^xsd:string ;
    neo:id "92d778092e1f15537cc90b4c85baadd7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 2 ;
    neo:text "Shortly afterwards the traveler rose and went in to the elder brother and said: 'Your young brother is a wonderful fellow."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1398 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_324 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "26. Trading Dialogue for Lodging"^^xsd:string ;
    neo:id "a2001912c2174cb9d8d6aaac173fddda"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 3 ;
    neo:text "He defeated me.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1399 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1374,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1400 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "26. Trading Dialogue for Lodging"^^xsd:string ;
    neo:id "35cefd5752234b135f8ef0639e763db1"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 1 ;
    neo:text "'Relate the dialogue to me,' said the elder one."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1401 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_111,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1395 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "26. Trading Dialogue for Lodging"^^xsd:string ;
    neo:id "b1388878fed9dbe74e5a3cacc016dd80"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 1 ;
    neo:text "'Well,' explained the traveler,' first I held up one finger, representing Buddha, the enlightened one."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1402 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1059,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_111,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "26. Trading Dialogue for Lodging"^^xsd:string ;
    neo:id "890d46c639e40636713662f88bc6148d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 2 ;
    neo:text "So he held up two fingers, signifying Buddha and his teaching."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1403 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_111,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1404,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1405,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1406,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1407,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_320 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "26. Trading Dialogue for Lodging"^^xsd:string ;
    neo:id "8a8bc14e40734bb85a6029f393218477"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 3 ;
    neo:text "I held up three fingers representing Buddha, his teaching, and his followers living the harmonious life."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1408 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1409,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1410,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1411,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_320 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "26. Trading Dialogue for Lodging"^^xsd:string ;
    neo:id "2a9b593887aedfe55beb2c93f72bba52"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 4 ;
    neo:text "Then he shook his clenched fist in my face, indicating that all three come from one realization."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_141 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_142,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_143,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_144,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_145,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_146 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:id "5d70a0b06b3d8f1b2c734714e4aab1df"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "For Orientals, more interested in being than in business the self- discovered man has been the most worthy of respect."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1412 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_320,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_342 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "26. Trading Dialogue for Lodging"^^xsd:string ;
    neo:id "33d8ef23aea690097fc29712af64dc2c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:sentence_number 1 ;
    neo:text "Thus he won and so I have no right to remain here.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1413 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1395 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "26. Trading Dialogue for Lodging"^^xsd:string ;
