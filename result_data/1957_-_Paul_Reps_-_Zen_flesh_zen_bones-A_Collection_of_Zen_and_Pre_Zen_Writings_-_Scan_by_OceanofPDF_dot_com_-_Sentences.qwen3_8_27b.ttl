    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 17 ;
    neo:sentence_number 5 ;
    neo:text "He served his patients well and, without even knowing it, he was free from concern over life and death."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1096 a neo:Document ;
