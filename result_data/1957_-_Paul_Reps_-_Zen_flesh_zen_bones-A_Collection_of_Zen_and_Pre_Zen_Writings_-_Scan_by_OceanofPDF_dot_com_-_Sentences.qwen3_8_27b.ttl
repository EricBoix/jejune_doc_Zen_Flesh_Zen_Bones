    neo:paragraph_number 3 ;
    neo:sentence_number 3 ;
    neo:text "While listening with ears one never can understand."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3973 a neo:Document ;
