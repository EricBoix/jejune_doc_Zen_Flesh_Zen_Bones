    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 23 ;
    neo:sentence_number 2 ;
    neo:text "After breath comes in (down) and just before turning up (out) -- the beneficence."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5121 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5117,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5122,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5123,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5124,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5125,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5126 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "44b683ab58686ac404bd125642467da5"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 24 ;
    neo:sentence_number 1 ;
    neo:text "As breath turns from down to up, and again as breath curves from up to down--through both these turns, realize."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5127 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5128,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5129,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5130 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "6faa5fbd99df7efb3c46dfbf1dcab085"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:sentence_number 1 ;
    neo:text "Or, whenever inbreath and outbreath fuse, at this instant touch the energyless energy-filled center."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5131 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5117,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5122,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5123,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5132,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5133 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "edbe3f6cb892d7306a5519c4aa68ab31"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:sentence_number 1 ;
    neo:text "Or, when breath is all out (up) and stopped of itself, or all in (down) and stopped--in such universal pause, one's small self vanishes."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5134 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1354,
