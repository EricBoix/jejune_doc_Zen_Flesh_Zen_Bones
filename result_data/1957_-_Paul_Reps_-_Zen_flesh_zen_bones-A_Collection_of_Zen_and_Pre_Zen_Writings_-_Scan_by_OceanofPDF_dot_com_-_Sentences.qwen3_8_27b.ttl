    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 17 ;
    neo:sentence_number 1 ;
    neo:text "I came from brilliancy And return to brilliancy."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_701 a neo:Document ;
