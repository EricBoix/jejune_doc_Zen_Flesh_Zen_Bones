    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 1 ;
    neo:text "Addressing the one who had written her, she said: 'If you really love me so much, come and embrace me now.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5141 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3828,
