        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_417 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "65. The Subjugation of a Ghost"^^xsd:string ;
    neo:id "b60bad7847380befb2df9ee7b775ea39"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 6 ;
    neo:text "The next time she appears, bargain with her."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2545 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_217,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2546,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2547,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2548,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_296 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "65. The Subjugation of a Ghost"^^xsd:string ;
    neo:id "e108fef8e8ab6692c4a9ebcf7fe21f27"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 7 ;
    neo:text "Tell her she knows so much you can hide nothing from her, and that if she will answer you one question, you promise to break your engagement and remain single.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2549 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2547,
