    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 4 ;
    neo:text "You may ask: What is a barrier of a patriarch?"^^xsd:string .

