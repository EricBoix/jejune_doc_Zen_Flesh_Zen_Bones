    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 3 ;
    neo:text "The day happened to be rainy, so Tenno wore wooden clogs and carried an umbrella."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1617 a neo:Document ;
