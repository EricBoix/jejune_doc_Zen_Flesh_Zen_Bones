    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "'Wait a while,' said Mokurai."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1189 a neo:Document ;
