    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 3 ;
    neo:text "'I might decide to do something else which would only imprison me again.'"^^xsd:string .

