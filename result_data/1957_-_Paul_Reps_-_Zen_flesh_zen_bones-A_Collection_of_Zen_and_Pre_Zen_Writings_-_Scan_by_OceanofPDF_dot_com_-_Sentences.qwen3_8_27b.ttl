    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 13 ;
    neo:sentence_number 4 ;
    neo:text "If that is your so-called Zen, I am not going to visit you any more.'"^^xsd:string .

