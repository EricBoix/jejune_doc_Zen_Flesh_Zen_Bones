    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:sentence_number 1 ;
    neo:text "Kusuda pondered this problem of Mu (No-thing) for two years."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1078 a neo:Document ;
