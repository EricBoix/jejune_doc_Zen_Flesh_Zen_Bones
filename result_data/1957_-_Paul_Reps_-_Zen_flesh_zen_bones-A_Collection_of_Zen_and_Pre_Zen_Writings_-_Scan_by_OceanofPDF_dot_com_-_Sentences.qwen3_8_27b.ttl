    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "c59037ea4d61537987ef5a757a17ea2b"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:sentence_number 2 ;
    neo:text "She passed away when she was still exquisitely beautiful and hardly thirty years old."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_789 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_417,
