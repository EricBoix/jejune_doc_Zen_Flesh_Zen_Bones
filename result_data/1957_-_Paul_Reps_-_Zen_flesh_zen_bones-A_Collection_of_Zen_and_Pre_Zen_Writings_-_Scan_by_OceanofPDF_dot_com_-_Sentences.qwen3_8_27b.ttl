        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_320,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_674 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "27. The Voice of Happiness"^^xsd:string ;
    neo:id "aaafbd8edb1470ff55965484d4ed9bc4"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "Ordinarily when I hear someone congratulate another upon his happiness or success, I also hear a secret tone of envy."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1446 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1441,
