    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:sentence_number 1 ;
    neo:text "When Shoun was old he knew his end was approaching."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_962 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254,
