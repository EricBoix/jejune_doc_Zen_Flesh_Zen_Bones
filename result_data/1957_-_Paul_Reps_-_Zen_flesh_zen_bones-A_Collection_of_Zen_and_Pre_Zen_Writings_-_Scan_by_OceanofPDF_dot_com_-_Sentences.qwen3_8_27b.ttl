    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 122 ;
    neo:sentence_number 1 ;
    neo:text "Be the unsame same to friend as to stranger, in honor and dishonor."^^xsd:string .

