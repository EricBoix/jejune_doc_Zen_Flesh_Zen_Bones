    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 2 ;
    neo:text "But when the master himself found the snake's head in his bowl, he summoned the cook, 'What is this?'"^^xsd:string .

