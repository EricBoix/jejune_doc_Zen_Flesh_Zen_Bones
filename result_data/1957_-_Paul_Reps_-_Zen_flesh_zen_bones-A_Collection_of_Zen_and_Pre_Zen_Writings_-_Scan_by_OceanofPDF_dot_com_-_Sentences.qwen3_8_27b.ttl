    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 2 ;
    neo:text "'My work is done.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2423 a neo:Document ;
