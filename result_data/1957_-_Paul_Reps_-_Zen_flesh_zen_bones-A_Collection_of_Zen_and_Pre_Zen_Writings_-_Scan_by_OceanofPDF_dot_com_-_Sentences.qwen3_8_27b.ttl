    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 6 ;
    neo:text "Under no circumstance did the teacher ever claim 'I am the successor of So-and-so.'"^^xsd:string .

