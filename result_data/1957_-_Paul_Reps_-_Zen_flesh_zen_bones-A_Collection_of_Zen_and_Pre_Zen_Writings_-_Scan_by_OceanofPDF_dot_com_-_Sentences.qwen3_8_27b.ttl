    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "Joshu said: \"An oak tree in the garden.\""^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4486 a neo:Document ;
