    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 17 ;
    neo:sentence_number 2 ;
    neo:text "His mind became placid."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1087 a neo:Document ;
