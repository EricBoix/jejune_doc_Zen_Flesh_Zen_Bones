ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4427 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3485,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3890 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "34. Learning Is Not the Path"^^xsd:string ;
    neo:id "df53e14418ffa56d4b4d0257088a95bc"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "Mumon's comment: Nansen was getting old and forgot to be ashamed."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4428 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4429,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4430,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4431 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "34. Learning Is Not the Path"^^xsd:string ;
    neo:id "33dd1df5d9ee85e9146ab9ffd781fca8"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 2 ;
    neo:text "He spoke out with bad breath and exposed the scandal of his own home."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_443 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_409,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_439,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_444,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_445 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "3. Is That So?"^^xsd:string ;
    neo:id "feff2a84719d59413f765aee17a4f04a"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:sentence_number 1 ;
    neo:text "The mother and father of the girl at once went to Hakuin to ask his forgiveness, to apologize at length, and to get the child back again."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4432 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1051,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4433 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "34. Learning Is Not the Path"^^xsd:string ;
    neo:id "f7a12d42d40571584822cb7c56229869"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 3 ;
    neo:text "However, there are few who appreciate his kindness."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4434 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_341,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3530,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4045,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4435 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "34. Learning Is Not the Path"^^xsd:string ;
    neo:id "d62e4e69c04b3609a91166512db8f4e1"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "When the sky is clear the sun appears, When the earth is parched rain will fall."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4436 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2583,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_346,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4437 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "34. Learning Is Not the Path"^^xsd:string ;
    neo:id "c08565212ea34a13e2556ed0298da473"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 2 ;
    neo:text "He opened his heart fully and spoke out, But it was useless to talk to pigs and fish."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4438 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_318,
