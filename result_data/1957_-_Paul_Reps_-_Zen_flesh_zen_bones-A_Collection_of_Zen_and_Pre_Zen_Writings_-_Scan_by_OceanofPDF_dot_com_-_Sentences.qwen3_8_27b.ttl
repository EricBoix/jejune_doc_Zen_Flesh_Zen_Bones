        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4377,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_542 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "31. Joshu Investigates"^^xsd:string ;
    neo:id "a05bd3f12953d89c26a9694be09f59a4"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 1 ;
    neo:text "Mumon's comment: The old woman understood how war is planned, but she did not know how spies sneak in behind her tent."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4378 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4379,
