    neo:id "26a292a5105c1e1a849e484ac516c986"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 2 ;
    neo:text "someone asked."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_675 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_643 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "578fead2fe0243a7fecc86e908a55160"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:sentence_number 1 ;
    neo:text "'Yes,' answered Hoshin."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_677 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_217,
