    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 7 ;
    neo:text "A letter afterwards from his teacher made no mention of clothes."^^xsd:string .

