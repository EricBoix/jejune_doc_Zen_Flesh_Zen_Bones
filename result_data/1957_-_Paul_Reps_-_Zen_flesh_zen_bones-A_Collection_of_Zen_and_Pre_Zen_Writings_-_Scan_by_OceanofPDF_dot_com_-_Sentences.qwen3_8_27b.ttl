    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "Zen masters give personal guidance in a secluded room."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3035 a neo:Document ;
