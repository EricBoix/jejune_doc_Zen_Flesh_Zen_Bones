    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 3 ;
    neo:text "This made the youth quite angry."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2985 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2967,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_543 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "82. Nothing Exists"^^xsd:string ;
    neo:id "c9e164e0799f39478d061da3b987171a"^^xsd:string ;
