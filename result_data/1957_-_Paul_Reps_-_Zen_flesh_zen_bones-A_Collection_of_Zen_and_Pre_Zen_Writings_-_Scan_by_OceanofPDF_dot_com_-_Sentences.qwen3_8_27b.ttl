    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "Tetsugen, a devotee of Zen in Japan, decided to publish the sutras, which at that time were available only in Chinese."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1648 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1649,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1650,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1651,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1652,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1653 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "37. Publishing the Sutras"^^xsd:string ;
    neo:id "27d411c8c44ac3e5f0f02ece9643fdb2"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "The books were to be printed with wood block in an edition of seven thousand copies, a tremendous undertaking."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1654 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1647,
