    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "899147bd99e58c30bab8e2bdae11323c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 1 ;
    neo:text "With such a beginning, Kusuda lost his chance to test the master, so reluctantly be asked if he might receive Zen instruction."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1047 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_248,
