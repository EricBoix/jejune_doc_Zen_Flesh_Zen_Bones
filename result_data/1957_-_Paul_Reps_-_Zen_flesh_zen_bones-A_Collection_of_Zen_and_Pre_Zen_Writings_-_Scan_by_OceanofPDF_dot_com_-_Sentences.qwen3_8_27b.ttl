    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:sentence_number 2 ;
    neo:text "He said: \"However abstruse the teachings are, in comparison with this enlightenment they are like a single hair to the great sky."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4267 a neo:Document ;
