    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 3 ;
    neo:text "\"From now on,\" said Tokusan, \"I will not doubt the teacher's words.\""^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4252 a neo:Document ;
