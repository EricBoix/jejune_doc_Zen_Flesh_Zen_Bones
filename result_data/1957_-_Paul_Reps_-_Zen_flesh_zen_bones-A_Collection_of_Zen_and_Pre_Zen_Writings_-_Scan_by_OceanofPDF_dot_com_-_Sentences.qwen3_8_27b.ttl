    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "40. In Dreamland"^^xsd:string ;
    neo:id "547d179b18f92af7fba3c4e30ecbc986"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 5 ;
    neo:text "our schoolmaster demanded."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1776 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1760,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1777,
