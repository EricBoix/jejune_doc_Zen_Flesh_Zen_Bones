    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "72. The Blockhead Lord"^^xsd:string ;
    neo:id "41b46186e1cbc404f1d763d5f77c259c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "So, instead of building a temple for Gudo the lord built it for Daigu and studied Zen with him."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2712 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2713,
