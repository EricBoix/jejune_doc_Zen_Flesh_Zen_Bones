    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 30 ;
    neo:sentence_number 2 ;
    neo:text "Let form fill with breath-essence to the top of the head, and there shower as light."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_5153 a neo:Document ;
