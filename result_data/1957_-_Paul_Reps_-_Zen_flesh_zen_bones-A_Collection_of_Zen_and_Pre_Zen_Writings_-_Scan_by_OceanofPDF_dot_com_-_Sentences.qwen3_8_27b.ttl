    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:sentence_number 2 ;
    neo:text "So Gudo beat the floor with his hand as if to awaken him, and the emperor was enlightened!"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2446 a neo:Document ;
