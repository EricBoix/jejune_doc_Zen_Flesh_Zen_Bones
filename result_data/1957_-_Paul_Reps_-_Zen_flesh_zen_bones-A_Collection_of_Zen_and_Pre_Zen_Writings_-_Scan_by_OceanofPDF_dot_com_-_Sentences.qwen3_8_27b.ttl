    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "'Why is the head of a dead cat the most valuable thing in the world?'"^^xsd:string .

