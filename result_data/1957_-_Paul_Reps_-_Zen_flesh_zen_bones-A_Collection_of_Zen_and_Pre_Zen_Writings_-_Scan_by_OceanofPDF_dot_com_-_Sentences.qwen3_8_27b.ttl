    neo:sentence_number 2 ;
    neo:text "Then he announced to the people about him: 'The funeral ceremony is over."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_958 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_217,
