        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_582 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "76. The Stone Mind"^^xsd:string ;
    neo:id "11d66fb66963735d212f0dae5e16602e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "Hogen, a Chinese Zen teacher, lived alone in a small temple in the country."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2784 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1297,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2785,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2786,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2787 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "76. The Stone Mind"^^xsd:string ;
    neo:id "ae43ad5e30e9dda2e95406aa38338aa4"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "One day four traveling monks appeared and asked if they might make a fire in his yard to warm themselves."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2788 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1631,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1632,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2783,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2787 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "76. The Stone Mind"^^xsd:string ;
    neo:id "94c7c4497a2bfb220fc6dc02361bc6e2"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "While they were building the fire, Hogen heard them arguing about subjectivity and objectivity."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2789 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2790,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_348 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "76. The Stone Mind"^^xsd:string ;
    neo:id "b4177841664a195103c132997195ca84"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 2 ;
    neo:text "He joined them and said: There is a big stone."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2791 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_121,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1467,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_161,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_217,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2792 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "76. The Stone Mind"^^xsd:string ;
    neo:id "157cad1e936d2469b878eb0b73423506"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 3 ;
    neo:text "Do you consider it to be inside or outside your mind?'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2793 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_121,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2794,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2795,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_518,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_854 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "76. The Stone Mind"^^xsd:string ;
    neo:id "f2d9e32583cc9eb5b99f69face5b7e52"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "One of the monks replied: 'From the Buddhist viewpoint everything is an objectification of mind, so I would say that the stone is inside my mind.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2796 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2783,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2797 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "76. The Stone Mind"^^xsd:string ;
    neo:id "f6ce4679da95ebe5dc1deee252a1c96a"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 1 ;
    neo:text "'Your head must feel very heavy', observed Hogen."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2798 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_121,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2794 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "76. The Stone Mind"^^xsd:string ;
    neo:id "b40c73733382022b807f36fcca3c5f31"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 2 ;
    neo:text "'if you are carrying around a stone like that in your mind.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2799 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2800,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_58,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_809 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "77. No Attachment to Dust"^^xsd:string ;
    neo:id "6149b296375c188f13d135c4aa702637"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "Zengetsu, a Chinese master of the T'ang dynasty, wrote the following advice for his pupils:"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2801 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2676,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2767,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2802,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2803,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2804,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2805 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "77. No Attachment to Dust"^^xsd:string ;
    neo:id "e9bd3696980939b440aa16f90bdf65e4"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "Living in the world yet not forming attachments to the dust of the world is the way of a true Zen student."^^xsd:string .

