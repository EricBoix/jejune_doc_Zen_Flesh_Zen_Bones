    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "And he also said: \"It is not necessary for speech to come from the tongue.\""^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4066 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3485,
