    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "29. No Water, No Moon"^^xsd:string ;
    neo:id "7dbb99940a7b075af6c188213e522535"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "When the nun Chiyono studied Zen under Bukko of Engarku she was unable to attain the fruits of meditation for a long time."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1481 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1224,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1482,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1483,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1484,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_417 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "29. No Water, No Moon"^^xsd:string ;
    neo:id "4219406cf5d6e9dcdd0bbbdff6978690"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "At last one moonlit night she was carrying water in an old pail bound with bamboo."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1485 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1478,
