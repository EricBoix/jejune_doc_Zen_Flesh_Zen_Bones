    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 31 ;
    neo:sentence_number 3 ;
    neo:text "Similarly, at any point in space or on a wall -- until the point dissolves."^^xsd:string .

