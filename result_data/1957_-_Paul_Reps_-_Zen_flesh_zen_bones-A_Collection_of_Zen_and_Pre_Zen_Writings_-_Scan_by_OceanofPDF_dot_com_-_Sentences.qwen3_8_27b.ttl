    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 3 ;
    neo:text "Shut yourself up in a little temple in a remote part of the mountain."^^xsd:string .

