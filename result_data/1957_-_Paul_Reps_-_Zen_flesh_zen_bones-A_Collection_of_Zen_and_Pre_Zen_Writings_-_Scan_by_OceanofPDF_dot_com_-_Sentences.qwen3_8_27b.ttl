    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "26. Trading Dialogue for Lodging"^^xsd:string ;
    neo:id "74fd9c22049341766509fa3794db226f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:sentence_number 4 ;
    neo:text "So I got mad and started to punch him, but he ran out and that ended it.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1434 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1435,
