    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:sentence_number 1 ;
    neo:text "\"What have you attained?\""^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_425 a neo:Document ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
