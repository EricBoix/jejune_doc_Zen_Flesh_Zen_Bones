    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "Mumon's comment: Fuketsu used to have lightning Zen."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4167 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1278,
