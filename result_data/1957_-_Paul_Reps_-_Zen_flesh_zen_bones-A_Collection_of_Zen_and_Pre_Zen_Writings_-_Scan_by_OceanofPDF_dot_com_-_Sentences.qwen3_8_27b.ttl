    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 3 ;
    neo:text "He became Nan-in's pupil, and he studied six more years to accomplish his every-minute Zen."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1627 a neo:Document ;
