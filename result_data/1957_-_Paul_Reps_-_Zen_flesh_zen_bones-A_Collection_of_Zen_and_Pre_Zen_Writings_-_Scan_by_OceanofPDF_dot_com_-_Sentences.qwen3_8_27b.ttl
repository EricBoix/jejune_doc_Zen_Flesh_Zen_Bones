    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 17 ;
    neo:sentence_number 1 ;
    neo:text "Kusuda continued in concentration for another year and a half."^^xsd:string .

