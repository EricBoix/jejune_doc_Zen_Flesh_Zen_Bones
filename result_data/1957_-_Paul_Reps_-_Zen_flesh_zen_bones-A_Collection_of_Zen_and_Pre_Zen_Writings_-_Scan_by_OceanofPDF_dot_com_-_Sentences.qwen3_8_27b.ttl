    neo:sentence_number 3 ;
    neo:text "So he said to the cook: Then you think I shouldn't eat at all.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2126 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2127,
