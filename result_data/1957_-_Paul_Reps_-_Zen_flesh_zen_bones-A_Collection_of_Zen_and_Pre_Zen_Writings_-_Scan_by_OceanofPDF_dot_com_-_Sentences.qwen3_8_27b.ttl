    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:sentence_number 2 ;
    neo:text "When you enter this Mu and there is no discontinuation, your attainment will be as a candle burning and illuminating the whole universe."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_3543 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2197,
