        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4364,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_517 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "31. Joshu Investigates"^^xsd:string ;
    neo:id "6aafa401531d62f5e0c794ed701aa293"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "A traveling monk asked an old woman the road to Taizan, a popular temple supposed to give wisdom to the one who worships there."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4365 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4366,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_517 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "31. Joshu Investigates"^^xsd:string ;
    neo:id "9b1c3d1a1c4631f6bc48991f44f5ae38"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "The old woman said: \"Go straight ahead.\""^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4367 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_417,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4368,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_530 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "31. Joshu Investigates"^^xsd:string ;
    neo:id "063323230cfca801946015430927f12b"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 3 ;
    neo:text "When the monk proceeded a few steps, she said to herself: \"He also is a common church-goer.\""^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_4369 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1781,
