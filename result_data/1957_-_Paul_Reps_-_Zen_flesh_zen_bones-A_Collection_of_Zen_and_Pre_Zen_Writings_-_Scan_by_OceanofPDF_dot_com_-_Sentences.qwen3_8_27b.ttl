    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:sentence_number 4 ;
    neo:text "Go home and take care of your patients.'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1058 a neo:Document ;
