    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "Tenno, confused, had no instant answer."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1624 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254,
