    neo:id "3fc91559a50bf9f874e0284a91d26af9"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 2 ;
    neo:text "He was smiling."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2138 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2113,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2139,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_254 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "51. Sour Miso"^^xsd:string ;
    neo:id "548bc5ae02266532d4b850161001269a"^^xsd:string ;
