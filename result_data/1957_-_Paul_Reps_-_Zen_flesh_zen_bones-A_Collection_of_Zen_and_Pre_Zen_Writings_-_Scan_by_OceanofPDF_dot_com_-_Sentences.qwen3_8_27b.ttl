    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "53. The Giver Should be Thankful"^^xsd:string ;
    neo:id "f92d61932b4e25eabbcb01fe22245b9a"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "While Seisetsu was the master of Engaku in Kamakura he required larger quarters, since those in which he was teaching were overcrowded."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2151 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2152,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2153,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2154,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_275 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "53. The Giver Should be Thankful"^^xsd:string ;
    neo:id "559bb9e1c74f9a343baf668d4bab0d41"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "Umezu Seibei, a merchant of Edo, decided to donate five hundred pieces of gold called ryo toward the construction of a more commodious school."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2155 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_2156,
