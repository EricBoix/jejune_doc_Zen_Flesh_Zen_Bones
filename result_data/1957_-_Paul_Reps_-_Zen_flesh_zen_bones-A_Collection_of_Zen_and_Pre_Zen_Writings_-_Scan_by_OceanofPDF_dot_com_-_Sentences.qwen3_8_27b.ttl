    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:sentence_number 1 ;
    neo:text "The flames arose, and she passed away."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1309 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1310,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1311,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1312,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_334,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_455 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "24. Reciting Sutras"^^xsd:string ;
    neo:id "cd878a14983d1a23a5177331641632ef"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 1 ;
    neo:text "A farmer requested a Tendai priest to recite sutras for his wife, who had died."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1313 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1314,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1315,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1316,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1317 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "24. Reciting Sutras"^^xsd:string ;
    neo:id "3eb65e335edac32bc8289d873fc65175"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 2 ;
    neo:text "After the recitation was over the farmer asked: 'Do you think my wife will gain merit from this?'"^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1318 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1319,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_1320,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_334,
        ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_478 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "24. Reciting Sutras"^^xsd:string ;
    neo:id "3d8a4fb554c4160a0383b07213712b68"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:sentence_number 1 ;
    neo:text "'Not only your wife but all sentient beings will benefit from the recitation of sutras,' answered the priest."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_132 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_131,
