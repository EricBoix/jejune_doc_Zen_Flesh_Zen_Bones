    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:sentence_number 3 ;
    neo:text "If you say yes or no, You lose your own Buddha-nature."^^xsd:string .

