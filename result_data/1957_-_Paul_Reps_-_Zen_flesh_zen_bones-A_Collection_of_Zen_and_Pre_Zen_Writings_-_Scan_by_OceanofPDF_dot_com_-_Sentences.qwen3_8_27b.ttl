    neo:paragraph_number 3 ;
    neo:sentence_number 1 ;
    neo:text "The emperor, observing how worn his garments were, gave Yamaoka some money to buy new ones."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_257 a neo:Document ;
    neo:MENTIONS ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_258,
