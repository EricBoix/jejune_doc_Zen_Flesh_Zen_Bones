    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:sentence_number 3 ;
    neo:text "In time the vow has become a men formality, and for this reason the pupil who died by the hand of Ekido was made to appear a martyr."^^xsd:string .

ex:node_4_e6fd553a_757d_4b22_bddf_2b1da6c9e882_272 a neo:Document ;
