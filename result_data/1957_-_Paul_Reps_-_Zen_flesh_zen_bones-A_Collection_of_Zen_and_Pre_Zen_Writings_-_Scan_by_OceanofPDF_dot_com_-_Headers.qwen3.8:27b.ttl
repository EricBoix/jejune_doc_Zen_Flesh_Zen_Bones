        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_415,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_416 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "47. Accurate Proportion"^^xsd:string ;
    neo:id "eda3e473653de6d8edd4f27a7862a6bb"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text """Sen no Rikyu, a tea-master, wished to hang a flower basket on a column. He asked a carpenter to help him, directing the man to place it a little higher or lower, to the right or left, until he had found exactly the right spot. That's the place,' said Sen no Rikyu finally.

The carpenter, to test the master, marked the spot and then pretended he had forgotten. Was this the place? 'Was this the place, perhaps?' the carpenter kept asking, pointing to various places on the column.

But so accurate was the tea-master's sense of proportion that it was not until the carpenter reached the identical spot again that its location was approved."""^^xsd:string .

