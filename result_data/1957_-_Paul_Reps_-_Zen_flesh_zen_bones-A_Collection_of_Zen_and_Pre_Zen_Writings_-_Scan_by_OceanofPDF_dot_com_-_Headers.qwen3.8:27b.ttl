        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_363,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_364,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_365 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "40. In Dreamland"^^xsd:string ;
    neo:id "6e074e66ac0cbe7c654164ec24af2884"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text """'Our schoolmaster used to take a nap every afternoon,' related a disciple of Soyen Shaku. 'We children asked him why he did it and he told us: 'I go to dreamland to meet the old sages just as Confucius did.' When Confucius slept, he would dream of ancient sages and later tell his followers about them.

'It was extremely hot one day so some of us took a nap. Our schoolmaster scolded us. "We went to dreamland to meet the ancient sages the same as Confucius did," we explained. "What was the message from those sages?" our schoolmaster demanded. One of us replied: "We went to dreamland and met the sages and asked than if our schoolmaster came there every afternoon, but they said they had never seen any such fellow.\""""^^xsd:string .

ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_366 a neo:Document ;
    neo:MENTIONS ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_200,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_367,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_38 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "41. Joshu's Zen"^^xsd:string ;
    neo:id "62e5053cd0d8fc5516ba7442c7e7dbea"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text """Joshu began the study of Zen when he was sixty years old and continued until he was eighty, when he realized Zen.

He taught from the age of eighty until he was one hundred and twenty. A student once asked him: 'If I haven't anything in my mind, what shall I do?'

Joshu replied: 'Throw it out.'

'But if I haven't anything how on I throw it out?' continued the questioner.

'Well,' said Joshu, 'then carry it out.'"""^^xsd:string .

ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_368 a neo:Document ;
    neo:MENTIONS ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_235,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_327,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_369,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_370 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "42. The Dead Man's Answer"^^xsd:string ;
    neo:id "f60888a7ffdf15e5664af67679b778d6"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text """When Mamiya, who later became a well-known preacher, went to a teacher for personal guidance, he was asked to explain the sound of one hand.

Mamiya concentrated upon what the sound of one hand might be. 'You are not working hard enough,' his teacher told him. 'You are too attached to food, wealth, things, and that sound. It would he better if you died. That would solve the problem.'

The next time Mamiya appeared before his teacher he was again asked what he had to show regarding the sound of one hand. Mamiya at once fell over as if he were dead.

'You are dead all right' observed the teacher. 'But how about that sound?'

'I haven't solved that yet,' replied Mamiya, looking up. 'Dead men do not speak,' said the teacher.' Get out!'"""^^xsd:string .

