        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_975 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "22. Kashapa's Preaching Sign"^^xsd:string ;
    neo:id "bc7118925ea6c738468317ebd1a706b0"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text """Ananda asked Kashapa: "Buddha gave you the golden-woven robe of successorship. What else did he give you?"

Kashapa said: "Ananda."

Ananda answered: "Yes, brother."

Said Kashapa: "Now you can take down my preaching sign and put up your own."

Mumon's comment: If one understands this, he will see the old brotherhood still gathering, but if not, even though he has studied the truth from ages before the Buddhas, he will not attain enlightenment.

The point of the question is dull but the answer is intimate. How many persons hearing it will open their eyes? Elder brother calls and younger brother answers, This spring does not belong to the ordinary season."""^^xsd:string .

ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_976 a neo:Document ;
    neo:MENTIONS ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_317,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_318,
