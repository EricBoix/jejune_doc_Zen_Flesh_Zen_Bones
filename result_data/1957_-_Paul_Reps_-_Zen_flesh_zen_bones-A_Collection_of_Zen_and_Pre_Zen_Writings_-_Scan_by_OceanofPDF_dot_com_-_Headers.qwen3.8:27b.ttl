        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_55 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "1. A Cup of Tea"^^xsd:string ;
    neo:id "b413d9f8cea9a4bd1d6646ca20924f00"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text """Nan-in, a Japanese master during the Meiji era (1868-1912) received a university professor who came to inquire about Zen.

Nan-in saved tea. He poured his visitor's cup full, and then kept on pouring.

The professor watched the overflow until he no longer could restrain himself. 'It is overfull. No more will go in!'

'Like this cup,' Nan-in said. 'You are full of your own opinions and speculations. How can I show you Zen unless you first empty your cup? '"""^^xsd:string .

ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_500 a neo:Document ;
    neo:MENTIONS ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_35,
