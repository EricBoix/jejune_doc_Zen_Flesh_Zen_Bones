        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_85 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "33. Mokusen's Hand"^^xsd:string ;
    neo:id "f20ec4bf9c5e6446479074b9e4791560"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text """Mokusen Hiki was living in a temple in the province of Tamba. One of his adherents complained of the stinginess of his wife. Mokusen visited the adherent's wife and showed her his clenched fist before her face.

'What do you mean by that?' asked the surprised woman.

'Suppose my fist were always like that. What would you call it?' he asked.

'Deformed,' replied the woman.

Then he opened his hand flat in her face and asked: 'Suppose it were always like that. What then?'

'Another kind of deformity,' said the wife.

'If you understand that much,' finished Mokusen, 'you are a good wife.' Then he left.

After his visit, this wife helped her husband to distribute as well as to save."""^^xsd:string .

ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_314 a neo:Document ;
    neo:MENTIONS ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_315,
