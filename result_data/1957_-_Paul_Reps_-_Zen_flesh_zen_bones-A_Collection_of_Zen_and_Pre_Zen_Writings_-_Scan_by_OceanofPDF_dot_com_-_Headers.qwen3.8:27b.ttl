        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_71 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "57. The Gates of Paradise"^^xsd:string ;
    neo:id "cba642c4beed0fba46816da0eed4ca17"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text """A soldier named Nobushige came to Hakuin, and asked: 'Is there really a paradise and a hell?'

'Who are you? ' Inquired Hakuin.

'I am a samurai,' the warrior replied.

'You, a soldier!' exclaimed Hakuin. 'What kind of ruler would have you as his guard? Your face looks like that of a beggar.'

Nobushige became so angry that he began to draw his sword, but Hakuin continued: 'So you have a sword! Your weapon is probably much too dull to cut off my head.'

As Nohushige drew his sword Hakuin remarked: 'Here open the gates of hell!'

At these words the samurai, perceiving the master's discipline, sheathed his sword and bowed.

'Here open the gates of paradise,' said Hakuin."""^^xsd:string .

ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_478 a neo:Document ;
    neo:MENTIONS ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_141,
