    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "48. Black-Nosed Buddha"^^xsd:string ;
    neo:id "2663841b73485c8db764799e26755ae3"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text """A nun who was searching for enlightenment made a statue of Buddha and covered it with gold leaf. Wherever she went she carried this golden Buddha with her.

Years passed and, still carrying her Buddha, the nun came to live in a small temple in a country where there were many Buddha's, each one with its own particular shrine.

The nun wished to burn incense before her golden Buddha. Not liking the idea of the perfume straying to the others, she devised a funnel through which the smoke would ascend only to her statue. This blackened the nose of the Golden Buddha making it especially ugly."""^^xsd:string .

ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_425 a neo:Document ;
    neo:MENTIONS ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_38,
