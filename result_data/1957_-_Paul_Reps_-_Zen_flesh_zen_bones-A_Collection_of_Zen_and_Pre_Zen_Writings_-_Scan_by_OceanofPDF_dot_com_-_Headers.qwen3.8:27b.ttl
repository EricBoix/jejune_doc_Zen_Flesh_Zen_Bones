        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_1204,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_263,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_331,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_332,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_471,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_540,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_952 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "10 BULLS"^^xsd:string ;
    neo:h3 "5. Taming the Bull"^^xsd:string ;
    neo:id "a85c183e28a13a0218f3f9fc875b87eb"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text """The whip and rope are necessary, Else he might stray off down some dusty road. Being well trained, he becomes naturally gentle. Then, unfettered, he obeys his master.

Comment: When one thought arises, another thought follows. When the first thought springs from enlightenment, all subsequent thoughts are true. Through delusion, one makes everything untrue. Delusion is not caused by objectivity; it is the result of subjectivity. Hold the nose-ring tight and do not allow even a doubt."""^^xsd:string .

ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_1205 a neo:Document ;
    neo:MENTIONS ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_1043,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_1181,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_1191,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_1206,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_1207,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_1208,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_1209,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_1210,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_1211,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_1212,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_149,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_398,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_544 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "10 BULLS"^^xsd:string ;
    neo:h3 "6. Riding the Bull Home"^^xsd:string ;
    neo:id "c949ffb0e564da9dc926fa947ddcccd3"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text """Mounting the bull, slowly I return homeward. The voice of my flute intones through the evening. Measuring with hand-beats the pulsating harmony, I direct the endless

rhythm. Whoever hears this melody will join me.

Comment: This struggle is over; gain and loss are assimilated. I sing the song of the village woodsman, and play the tunes of the children. Astride the bull, I observe the clouds above. Onward I go, no matter who may wish to call me back."""^^xsd:string .

