        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_942,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_943,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_95 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "18. Tozan's Three Pounds"^^xsd:string ;
    neo:id "58d09a0ce422e49bdae4e3ef87c3722f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text """A monk asked Tozan when he was weighing some flax: "What is Buddha?"

Tozan said: "This flax weighs three pounds."

Mumon's comment: Old Tozan's Zen is like a clam. The minute the shell opens you see the whole inside. However, I want to ask you: Do you see the real Tozan?

Three pounds of flax in front of your nose, Close enough, and mind is still closer. Whoever talks about affirmation and negation Lives in the right and wrong region."""^^xsd:string .

