        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_90 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "56. The True Path"^^xsd:string ;
    neo:id "202ba23798e04cc8872e764850c959da"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text """Just before Ninakawa passed away the Zen master Ikkyu visited him. 'Shall I lead you on Ikkyu asked.

Ninakawa replied: 'I came here alone and I go alone. What help could you be to me?'

Ikkyu answered: 'If you think you really come and go, that is your delusion. Let me show you the path on which there is no coming and no going.'

With his words Ikkyu had revealed the path so clearly that Ninakawa smiled and passed away."""^^xsd:string .

