        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_1175,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_673,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_849,
        ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_945 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "10 BULLS"^^xsd:string ;
    neo:h3 "2. Discovering the Footprints"^^xsd:string ;
    neo:id "1d20117595a3f484314e22894821ceca"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text """Along the riverbank under the trees, I discover footprints! Even under the fragrant grass I see his prints. Deep in remote mountains they are found. These traces no more can be hidden than one's nose, looking

heavenward.

Comment: Understanding the teaching, I see the footprints of the bull. Then I learn that, just as many utensils are made from one metal, so too are myriad entities made of the fabric of self. Unless I discriminate, how will I perceive the true from the untrue? Not yet having entered the gate, nevertheless I have discerned the path."""^^xsd:string .

