    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "63. Killing"^^xsd:string ;
    neo:id "e3dd33aa1b7d8fbd7f9e936d9253c2a3"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text "Gasan instructed his adherents one day: 'Those who speak against killing and who desire to spare the live of all conscious beings are right. It is good to protect even animals and insects. But what about those persons who kill time, what about those who are destroying wealth and those who destroy political economy? We should not overlook them. Furthermore, what of the one who preaches without enlightenment? He is killing Buddhism.'"^^xsd:string .

ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_519 a neo:Document ;
