    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "32. Inch Time Foot Gem"^^xsd:string ;
    neo:id "f0c436f3afb56a371954ac833b81a11b"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:text """A lord asked Takuan, a Zen teacher to suggest how he might pass the time. He felt his day very long attending his office and sitting stiffly to receive the homage of others.

Takuan wrote eight Chinese characters and gave them to the man:

Not twice this day

Inch time foot gem

This day will not come again.

Each minute is worth a priceless gem."""^^xsd:string .

ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_309 a neo:Document ;
    neo:MENTIONS ex:node_4_93f9d1d9_2fb5_44aa_a733_3324445f03ca_310,
