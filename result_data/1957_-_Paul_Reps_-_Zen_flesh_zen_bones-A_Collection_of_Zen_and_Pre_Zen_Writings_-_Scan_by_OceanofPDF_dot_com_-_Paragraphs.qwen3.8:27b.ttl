    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "19. Everyday Life Is the Path"^^xsd:string ;
    neo:id "6e5cb6537422407e5916af814ba6fe18"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "Nansen said: \"If you try to study, you will be far away from it.\""^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2516 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1437,
