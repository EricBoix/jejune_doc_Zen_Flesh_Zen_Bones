    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 113 ;
    neo:text "Wherever your mind is wandering, internally or externally at this very place, this."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3532 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2469,
