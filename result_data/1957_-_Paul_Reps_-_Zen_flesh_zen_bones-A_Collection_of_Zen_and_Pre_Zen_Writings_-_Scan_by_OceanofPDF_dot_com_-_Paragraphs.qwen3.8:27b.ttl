    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 117 ;
    neo:text "Look upon some object, then slowly withdraw your sight from it, then slowly withdraw your thought from it. Then."^^xsd:string .

