        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_370 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "10 BULLS"^^xsd:string ;
    neo:h3 "2. Discovering the Footprints"^^xsd:string ;
    neo:id "af942336d6be5ca41851d98132b0447b"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "Comment: Understanding the teaching, I see the footprints of the bull. Then I learn that, just as many utensils are made from one metal, so too are myriad entities made of the fabric of self. Unless I discriminate, how will I perceive the true from the untrue? Not yet having entered the gate, nevertheless I have discerned the path."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_301 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_294,
