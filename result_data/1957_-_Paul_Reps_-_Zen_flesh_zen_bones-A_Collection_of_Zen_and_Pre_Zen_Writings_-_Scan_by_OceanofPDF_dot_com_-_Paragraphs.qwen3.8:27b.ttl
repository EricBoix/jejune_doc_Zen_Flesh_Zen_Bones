    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "Foreword"^^xsd:string ;
    neo:id "873b4b861f1d248ae0fc1d39aea56d0a"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "101 Zen Stories was first published in 1919 by Rider and Company, London, and David McKay Company, Philadelphia. These stories recount actual experiences of Chinese and Japanese Zen teachers over a period of more than five centuries."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1000 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1001,
