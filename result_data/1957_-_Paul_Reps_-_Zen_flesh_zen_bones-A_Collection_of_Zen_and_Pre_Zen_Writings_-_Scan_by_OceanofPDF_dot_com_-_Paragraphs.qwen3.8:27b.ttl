    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 122 ;
    neo:text "Be the unsame same to friend as to stranger, in honor and dishonor."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_356 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_357,
