        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3258,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3259 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "46b7072181605460f37c42811a7fcc2d"^^xsd:string ;
