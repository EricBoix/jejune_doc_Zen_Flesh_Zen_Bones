    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:text "When prison stocks are iron and have no place for the head, the"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2493 a neo:Document ;
