    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:text "prisoner is doubly in trouble. When there is no place for Zen in the head of our generation, it is in"^^xsd:string .

