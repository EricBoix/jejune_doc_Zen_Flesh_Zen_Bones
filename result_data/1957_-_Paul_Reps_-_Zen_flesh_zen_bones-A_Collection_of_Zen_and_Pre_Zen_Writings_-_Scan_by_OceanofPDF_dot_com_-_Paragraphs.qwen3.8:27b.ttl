    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 112 ;
    neo:text "At the edge of a deep well look steadily into its depths until -- the wondrousness."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3528 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2372,
