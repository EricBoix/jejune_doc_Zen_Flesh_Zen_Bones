    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 39 ;
    neo:text "While listening to stringed instruments, hear their composite central sound; thus omnipresence."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_326 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_173,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_325 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "5. If You Love, Love Openly"^^xsd:string ;
    neo:id "2ce4d63fdb098c96c7258ff67c511715"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Eshun was very pretty even though her head was shaved and her dress plain. Several monks secretly fell in love with her."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3260 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3211,
