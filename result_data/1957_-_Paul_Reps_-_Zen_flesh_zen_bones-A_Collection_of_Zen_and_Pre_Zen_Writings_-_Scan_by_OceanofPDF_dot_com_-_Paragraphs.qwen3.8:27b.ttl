    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "But these girls slay men with their eyes.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1965 a neo:Document ;
