    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "A soldier may kill with his sword,"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1963 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1835,
