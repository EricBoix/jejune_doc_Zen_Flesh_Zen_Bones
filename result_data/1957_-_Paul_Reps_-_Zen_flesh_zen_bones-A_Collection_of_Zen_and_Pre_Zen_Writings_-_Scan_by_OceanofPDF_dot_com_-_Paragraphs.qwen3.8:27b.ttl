    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 46 ;
    neo:text "Suppose your passive form to be an empty room with walls of skin-- empty."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3282 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2290,
