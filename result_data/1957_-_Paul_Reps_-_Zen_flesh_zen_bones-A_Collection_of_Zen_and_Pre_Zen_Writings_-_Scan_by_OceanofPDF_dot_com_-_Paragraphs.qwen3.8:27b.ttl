    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "'I am going wherever the wind blows,' answered the other."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1982 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1976,
