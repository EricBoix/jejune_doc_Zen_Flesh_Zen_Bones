    neo:h3 "86. The Living Buddha and the Tubmaker"^^xsd:string ;
    neo:id "946d93ff8dfdd9e4768dfc77501b0556"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "'I understand you are a living Buddha,' the man protested. 'Even the stone Buddha's in the temple never refuse the numerous persons who come together before them. Why then should I be excluded?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1943 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_463,
