        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3251,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_768 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "bc86419bc0231156e4e3ef63b55ac258"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 37 ;
    neo:text "Intone a sound, as a-u-m, slowly. As sound enters soundfulness, so do you."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3252 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3253,
