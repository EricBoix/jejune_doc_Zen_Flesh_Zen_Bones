        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_996,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_997 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
