        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3255,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_738,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_768 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "4195158c6149846af1642a92d9b38d59"^^xsd:string ;
