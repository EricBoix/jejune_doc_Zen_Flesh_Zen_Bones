    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "Eshun did not reply. The following day the master gave a lecture to the group, and when it was over, Eshun arose."^^xsd:string .

