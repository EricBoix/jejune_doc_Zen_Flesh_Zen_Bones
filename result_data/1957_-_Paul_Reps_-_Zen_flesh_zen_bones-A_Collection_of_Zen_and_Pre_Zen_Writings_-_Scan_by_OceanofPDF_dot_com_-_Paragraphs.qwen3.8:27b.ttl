    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 132 ;
    neo:text "Each thing is perceived through knowing. The self shines in space through knowing. Perceive one being as knower and known."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3598 a neo:Document ;
