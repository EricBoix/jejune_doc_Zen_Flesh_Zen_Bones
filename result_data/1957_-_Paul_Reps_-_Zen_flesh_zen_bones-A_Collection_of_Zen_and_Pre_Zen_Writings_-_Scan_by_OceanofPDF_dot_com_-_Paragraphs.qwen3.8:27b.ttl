    neo:id "44d348359486bfa6f8566d5d5c76e1fd"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:text "'I'm glad too,' Shoun responded. Then he announced to the people about him: 'The funeral ceremony is over. You may bury the body.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_615 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_462,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_578,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_581,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_616,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_617 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "15. Shoun and His Mother"^^xsd:string ;
    neo:id "04a512ff10d3064dc32154b5b448a29a"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:text "When Shoun was old he knew his end was approaching. He asked his disciples to gather around him in the morning telling them he was going to pass on at noon. Burning incense before the picture of his mother and his old teacher, he wrote a poem:"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_618 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_370,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_371,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_619 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "15. Shoun and His Mother"^^xsd:string ;
    neo:id "a2fbfc4c9b2d2e849eae3b2880ed62ed"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:text "For fifty-six years I lived as best I could, Making my way in this world."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_620 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_233,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_621 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "15. Shoun and His Mother"^^xsd:string ;
    neo:id "c83eab40473b87b57ffb4e9aceec2e4d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 13 ;
    neo:text "Now the rain has ended, the clouds are clearing,"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_622 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_623,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_624 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "15. Shoun and His Mother"^^xsd:string ;
    neo:id "2ab908f4ebd76b15eb627b2f4bc51a68"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:text "The blue sky has a full moon."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_625 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_44,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_578,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_626,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_627 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "15. Shoun and His Mother"^^xsd:string ;
    neo:id "35e5216f792910698e059ac20fe96485"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:text "His disciples gathered about him, reciting a sutra, and Shoun passed on during the invocation."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_628 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_629,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_630,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_631 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "16. Not Far from Buddahood"^^xsd:string ;
    neo:id "1cd3caa71e46a2a589e67d7eed9d3914"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "A university student while visiting Gasan asked him: 'Have you ever read the Christian Bible?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_632 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_630,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_633,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_634,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_635,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_636 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "16. Not Far from Buddahood"^^xsd:string ;
    neo:id "1a06531cd82a9ddfcf77aac9837afe24"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "'No, read it to me,' said Gasan. The student opened the Bible and read from St Mattew: 'And why take ye thought for raiment? Consider the lilies of the field, how they grow. They toil not, neither do they spin, and yet I say unto you that even Solomon in all his glory was not arrayed like one of these. ...Take therefore no thought for the morrow, for the morrow shall take thought for the things of itself.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_637 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_630,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_638,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_639 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "16. Not Far from Buddahood"^^xsd:string ;
    neo:id "9768ee603172e3ea1bffb8d7a80ba02f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "Gasan said: 'Whoever uttered those words I consider an enlightened man.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_640 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_641,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_642,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_643,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_644,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_645,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_646,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_647,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_648 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "16. Not Far from Buddahood"^^xsd:string ;
    neo:id "23750e071562c53637172c8aa2ee7987"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "The student continued reading: 'Ask and it shall be given you, seek and ye shall find, knock and it shall be opened unto you. For everyone that asketh receiveth, and he that seeketh findeth, and to him that knocketh, it shall be opened.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_649 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_630,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_650 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "16. Not Far from Buddahood"^^xsd:string ;
    neo:id "f79e5f81409331e65c548f40ae5cb0e8"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "Gasan remarked: 'That is excellent. Whoever said that is not far from Buddhahood.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_651 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_541,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_652,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_653 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "a707596499e3f3f5598bf6298740c86f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "A young physician in Tokyo named Kusuda met a college friend who had been studying Zen. The young doctor asked him what Zen was."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_654 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_159,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_655,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_656 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "fe8e46dc21c7051246c836ab2714eeab"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "'I cannot tell you what it is,' the friend replied, 'but one thing is certain. If you understand Zen, you will not be afraid to die.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_657 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_178,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_652 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "f6f1638a1c1b819b3eb09ea12ab40990"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "That's fine: said Kusuda. 'I will try it. Where can I find a teacher?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_658 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_184,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_220,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_333,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_655 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "4f487f996b6c986eb547baa1fd1d21a6"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "'Go to the master Nan-in,' the friend told him."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_659 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_184,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_652,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_660 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "a0fcd0ccbe231ff40cca594f6710f25b"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "So Kusuda went to call on Nan-in. He carried a dagger nine and a half inches long to determine whether or not the teacher himself was afraid to die."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_661 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_184,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_652 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "972053e0eeda317a290e0b226cfdfd7e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "When Nan-in saw Kusuda he exclaimed: 'Hello, friend. How are you? We haven't seen each other for a long time!'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_662 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_652 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "3f696d4d66cd893b55f3fe5db7ea006f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "This perplexed Kusuda, who replied: 'We have never met before.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_664 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_184,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_665,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_666 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "ab0ace0b751572909166c66de4a008ba"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "'That's right,' answered Nan-in. I mistook you for another physician who is receiving instruction here.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_667 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_652,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_668,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_76 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "899147bd99e58c30bab8e2bdae11323c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:text "With such a beginning, Kusuda lost his chance to test the master, so reluctantly be asked if he might receive Zen instruction."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_669 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_184,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_665,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_670,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_671 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "6fab7f487ce2657ecdc091e097ec0b06"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:text "Nan-in said: 'Zen is not a difficult task. If you are a physician, treat your patients with kindness. That is Zen.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_672 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_184,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_652 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "90c0f51843da1a4d5da7697bb623b7aa"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:text "Kusuda visited Nan-in three times. Each time Nan-in told him the same thing.' A physician should not waste time around here. Go home and take care of your patients.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_673 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_251,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_652,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_674,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_675 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "6f29614859542a46b726da3307041fb8"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:text "It was not yet clear to Kusuda how such teaching could remove the fear of death. So on his fourth visit he complained:"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_676 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_261,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_370,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_670,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_674,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_677 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "95e454b4a20b84d2b9254b0cb8932e18"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 13 ;
    neo:text "'My friend told me when one learns Zen one loses his fear of death. Each time I come here all you tell me is to take care of my patients. I know that much. If that is your so-called Zen, I am not going to visit you any more.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_678 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_10,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_184,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_652,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_679,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_680 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "18e212083895e7efc253f64ab4d65ab1"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:text "Nan-in smiled and patted the doctor. 'I have been too strict with you. Let me give you a koan. ' He presented Kusuda with Joshu's Mu to work over, which is the first mind-enlightening problem in the book called The Gateless Gate."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_68 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_69,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_70,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_71 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "Foreword"^^xsd:string ;
    neo:id "6b7a27abd125c77c6c95751e52ab81e7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:text "No-thing (i.e. spirit) is reality.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_682 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_652,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_683,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_684 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "d70af3a2c70d82e3bba3cc83cc7266f4"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:text "Kusuda pondered this problem of Mu (No-thing) for two years. At length he thought he had reached certainty of mind."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_685 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_178,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_633,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_686 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "f5356471ecc067ba997dd14a9e67884f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:text "But his teacher commented: 'You are not in yet.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_687 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_47,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_652,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_670,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_688,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_689,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_690,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_691,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_692,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_693,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_97 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "693a38388ecb538ab6408957e3910cf2"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 17 ;
    neo:text "Kusuda continued in concentration for another year and a half. His mind became placid. Problems dissolved. No-thing became the truth. He served his patients well and, without even knowing it, he was free from concern over life and death."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_694 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_184,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_355 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "17. Stingy in Teaching"^^xsd:string ;
    neo:id "8840d5eb3a2387120a9f76eb0be2696d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 18 ;
    neo:text "Then when he visited Nan-in his old teacher just smiled."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_695 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_626,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_696,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_697,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_698,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_699,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_700,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_701,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_702,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_90 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "18. A Parable"^^xsd:string ;
    neo:id "b1fca81fb94dd8ebfd343e737ed0af91"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Buddha told a parable in a sutra: A man traveling across a field encountered a tiger. He fled, the tiger after him. Coming to a precipice, he caught hold of the root of a wild vine and swung himself down over the edge. The tiger sniffed at him from above. Trembling, the man looked down to where, far below, mother tiger was waiting to eat him. Only the vine sustained him."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_703 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_697,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_704,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_705,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_706,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_707 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "18. A Parable"^^xsd:string ;
    neo:id "8b2fa601028ccff4e530dc69041c7fbb"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Two mice one white and one black, little by little started to gnaw away the vine. The man saw a luscious strawberry near him. Grasping the vine with one hand, he plucked the strawberry with the other. How sweet it tasted!"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_708 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_241,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_709,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_710,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_711,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_712 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "19. The First Principle"^^xsd:string ;
    neo:id "35f3c0a39e619ddac892190ea955dd4a"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "When one goes to Obaku temple in Kyoto one sees carved over the gate the words ' The First principle '. The letters are unusually large, and those who appreciate calligraphy always admire them as being a masterpiece. They were drawn by Kosen two hundred years ago."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_713 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_711,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_712,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_714,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_715,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_716,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_717,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_718,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_719,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_720 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "19. The First Principle"^^xsd:string ;
    neo:id "693b9129820ce2d7395bb722d02feb68"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "When the master drew them he did so on paper, from which workmen made the larger carving in wood. As Kosen sketched the letters a bold pupil was with him who had made several gallons of ink for the calligraphy and who never failed to criticize his master's work."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_72 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_39,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_73 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "Foreword"^^xsd:string ;
    neo:id "32986b90e352490cd314df443b237fd8"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 13 ;
    neo:text "Bodhidharma commented: 'You have my bones'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_721 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_355,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_711,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_722 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "19. The First Principle"^^xsd:string ;
    neo:id "ad533599dc70ac6fcc137cfc27f01985"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "'That is not good,' he told Kosen after the first effort."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_723 a neo:Document ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "19. The First Principle"^^xsd:string ;
    neo:id "6054daf8b135c811f785ed0e3d7323c7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "'How is that one?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_724 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_725,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_726 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "19. The First Principle"^^xsd:string ;
    neo:id "da137af169709bc1db33c60f1f0f742d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "'Poor. Worse than before,' pronounced the pupil."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_727 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_711,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_725,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_728 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "19. The First Principle"^^xsd:string ;
    neo:id "803bd08c536feee02d72ddcd1d464ea2"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "Kosen patiently wrote one sheet after another until eighty-four First Principles had accumulated, still without the approval of the pupil."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_729 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_286,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_710,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_711 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "19. The First Principle"^^xsd:string ;
    neo:id "f9f9979e0153157da2690a29b5a6ee10"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "Then, when the young man stepped outside for a few moments, Kosen thought: 'Now is my chance to escape his keen eye,' and he wrote hurriedly, with a mind free from distraction: 'The First principle.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_730 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_725,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_731 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "19. The First Principle"^^xsd:string ;
    neo:id "4df00b27082b7027d958369c7e741f4b"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "'A masterpiece,' pronounced the pupil."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_732 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_543,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_733,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_734,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_735,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_736 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "20. A Mother's Advice"^^xsd:string ;
    neo:id "aa31d39fe56bda022a7e639bc1c5a738"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Jiun, a Shingon master, war a well-known Sanskrit scholar of the Tokugawa era. When he was young he used to deliver lectures to his brother students."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_737 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_289,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_610,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_738 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "20. A Mother's Advice"^^xsd:string ;
    neo:id "c54abe7e35607a3c2af13b7c22a00b10"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "His mother heard about this and wrote him a letter:"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_739 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_530,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_610,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_740,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_741,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_90 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "20. A Mother's Advice"^^xsd:string ;
    neo:id "ba4db2feab6900515b72ec608cbcdf18"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "'Son, I do not think you become a devotee of the Buddha because you desire to turn into a walking dictionary for others."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_74 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_75,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_76 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "Foreword"^^xsd:string ;
    neo:id "d67363840b2c8168e6c07e9c7bb8e172"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:text "Finally Eka bowed before the master--and remained silent."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_742 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_139,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_391,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_410,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_743,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_744,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_745,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_746,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_747,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_748 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "20. A Mother's Advice"^^xsd:string ;
    neo:id "e6a0911368ed317500b03e3538799baf"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "There is no end to information and commentation, glory and honor. I wish you would stop this lecture business. Shut yourself up in a little temple in a remote part of the mountain. Devote your time to meditation and in this way attain true realization.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_749 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_750,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_751,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_752,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_753,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_754,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_755 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "6055f9b832885b71eef035ee0969230c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "The masts of Kennin temple was Mokurai, Silent Thunder. He had a little protégé named Toyo who was only twelve years old. Toyo saw the olds disciples visit the master's room each morning and evening to receive instruction in sanzen or personal guidance in which they were given koans to stop mind- wandering."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_756 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_754,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_757 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "6902c2e1e34a92751d9a26a240a235b5"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Toro wished to do sanzen also."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_758 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_479 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "42c5345a4c247c082b897bb70287ccc3"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "'Wait a while,' said Mokurai. 'You are too young.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_761 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_285,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_312 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "7bd6482a3e468593166a48c6117e1ed8"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "But the child insisted, so the teacher finally consented."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_762 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_479,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_752,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_763,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_764 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "7d69ace7e4c7779a14d612e8446e94cb"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "In the evening little Toyo went at the props time to the threshold of Mokurai's sanzen room. He struck the gong to announce his presence, bowed respectfully three times outside the door, and went to sit before the master in respectful silence."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_765 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_479,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_766,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_767,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_768,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_769 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "dd53080f95543b8e9930fcd488960bf3"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "'You can hear the sound of two hands when they clap together,' said Mokurai. 'Now show me the sound of one hand.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_77 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_39,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_78 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "Foreword"^^xsd:string ;
    neo:id "a55ef8734fea54c041730a5456c2812b"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:text "Bodhidharma said: 'You have my marrow.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_770 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_210,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_593,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_752,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_771,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_772,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_773 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "7c6ea9c74454728206b68fe194e46a9e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "Toyo bowed and went to his room to consider this problem. From his window he could hear the music of the geishas."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_774 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_355,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_775 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "615af6e309c5e4c3c94b05199811459f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "'Ah, I have it!' he proclaimed."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_776 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_178,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_752,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_773,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_777,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_778 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "d9185125d9c617d786383938ca3d0608"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:text "The next evening, when his teacher asked him to illustrate the sound of one hand, Toyo began to play the music of the geishas."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_779 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_479,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_780 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "b96c6552aae6532ef063b8eb95242161"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:text "'No, no,' said Mokurai. 'That will never do. That is not the sound of one hand. You've not got it at all.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_781 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_593,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_752,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_778,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_782,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_783 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "bffeff775120fe6b8c0ee62a84c5a86b"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:text "Thinking that such music might interrupt, Toyo moved his abode to a quiet place. He meditated again. 'What can the sound of one hand be?' He happened to hear some water dripping. 'I have it,' imagined Toyo."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_784 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_178,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_752,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_785 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "ba08c3b129e287e6ddd819ca286c9293"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:text "When he next appeared before his teacher, Toyo imitated dripping water."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_786 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_479,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_767,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_768,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_785 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "d661655a146ee2ca30e00d97062ec76a"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 13 ;
    neo:text "'What is that?' asked Mokurai. That is the sound of dripping water, but not the sound of one hand. Try again.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_787 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_139,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_752,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_768,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_778,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_788,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_789 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "c6405ec27b62dfd574947d2fef25adb1"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:text "In vain Toyo meditated to hear the sound of one hand. He heard the sighing of the wind. But the sound was rejected."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_79 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_78,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_80,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_81,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_82,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_83,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_84,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_85,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_86,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_87,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_88 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "Foreword"^^xsd:string ;
    neo:id "b5f661a1ca2b40289e7cce5c1baafd53"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:text "Old Zen was so fresh it became treasured and remembered. Here are fragments of its skin flesh bones but not its marrow--never found in words."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_790 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_355,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_791,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_792 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "2e466e1873555c08a90ef6de441dd631"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:text "He heard the cry of an owl. This also was refused."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_793 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_778,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_794 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "ae4d54437d7a91a65363521d20b03f62"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:text "The sound of one hand was not the locusts."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_795 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_479,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_752,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_778 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "fde59c1a762b5761606288c7a3068329"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 17 ;
    neo:text "For more than ten times Toyo visited Mokurai with different sounds. All were wrong. For almost a year he pondered what the sound of one hand might be."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_796 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_752,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_797,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_798,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_799 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "1a0fb77619af85e3d0aab2d09d836cc8"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 18 ;
    neo:text "At last little Toyo entered true meditation and transcended all sounds. 'I could collect no more,' he explained later, ' so I reached the soundless sound.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_800 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_752,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_778 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "21. The Sound of One Hand"^^xsd:string ;
    neo:id "5c246dd3cae195215d0770881439cb4e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:text "Toyo had realized the sound of one hand."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_801 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_513,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_802,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_803 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "22. My Heart Burns Like Fire"^^xsd:string ;
    neo:id "d386a45990fc0bb2aca3c99abb3a0ba6"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Soyen Shaku, the first Zen teacher to come to America, said: 'My heart burns like fire but my eyes are as cold as dead ashes.' He made the following rules, which he practiced every day of his life."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_804 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_805,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_806,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_807,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_808 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "22. My Heart Burns Like Fire"^^xsd:string ;
    neo:id "221330a299869c808e3cec719a1dbf4f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "In the morning before dressing, light incense and meditate."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_809 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_587,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_810,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_811,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_812,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_813,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_814,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_815 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "22. My Heart Burns Like Fire"^^xsd:string ;
    neo:id "55c94cb6dde83f2d4704b3068cef8a22"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "Retire at a regular hour. Partake of food at regular intervals. Eat with moderation and never to the point of satisfaction."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_816 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_817,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_818,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_819,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_820 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "22. My Heart Burns Like Fire"^^xsd:string ;
    neo:id "84028d20e1bf950274fc372036379b04"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "Receive a guest with the same attitude you have when alone. When alone, maintain the same attitude you have in receiving guests."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_821 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_822,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_823 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "22. My Heart Burns Like Fire"^^xsd:string ;
    neo:id "30984645f2c483c65a8fd1584bc9708f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "Watch what you say, and whatever you say, practice it."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_824 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_825,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_826,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_827 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "22. My Heart Burns Like Fire"^^xsd:string ;
    neo:id "8568728ed9fdbbd499617bdc5c617e98"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "When an opportunity comes do not let it pass by, yet always think twice before acting."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_828 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_829,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_830,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_831,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_832 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "22. My Heart Burns Like Fire"^^xsd:string ;
    neo:id "b26da7aa2c4ab53dc11b273533ac5b31"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "Do not regret the past. Look to the future."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_833 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_279,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_834,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_835,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_836 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "22. My Heart Burns Like Fire"^^xsd:string ;
    neo:id "766448524b7cff9822c5e05f3ba02357"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "Have the fearless attitude of a hero and the loving heart of a child."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_837 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_261,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_838,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_839,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_840,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_841,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_842 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "22. My Heart Burns Like Fire"^^xsd:string ;
    neo:id "1b76b2e7eaf6c03d1a63f8a6a4b05bef"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:text "Upon retiring sleep as if you had entered your last sleep. Upon awakening, leave your bed behind you instantly as if you had cast away a pair of old shoes."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_843 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_173,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_325,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_717,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_844,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_845 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "23. Eshun's Departure"^^xsd:string ;
    neo:id "b2c9ebeaf24b082556d32820aefb61f9"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "When Eshun, the Zen nun, was past sixty and about to leave the world, she asked some monks to pile up wood in the yard."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_846 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_275,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_847 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "23. Eshun's Departure"^^xsd:string ;
    neo:id "691f2adc26ede959d30b914da2f55328"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Seating herself firmly in the center of the funeral pyre, she had it set fire around the edges."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_848 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_347,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_849 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "23. Eshun's Departure"^^xsd:string ;
    neo:id "037fe604958ab65750d7386759349426"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "'O nun!' shouted the monk, 'is it hot in there?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_850 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_325 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "23. Eshun's Departure"^^xsd:string ;
    neo:id "60f5d9b2489ee7366e12af01e5149304"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "'Such a matter would concern only a stupid person like yourself,' answered Eshun."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_851 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_275,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_852 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "23. Eshun's Departure"^^xsd:string ;
    neo:id "20cfdfbddad8126aac77e7bf201f1d6f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "The flames arose, and she passed away."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_855 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_230,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_297,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_856,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_857,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_858 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "24. Reciting Sutras"^^xsd:string ;
    neo:id "a18ca87d325a8b5bc27f5f3d623a6712"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "A farmer requested a Tendai priest to recite sutras for his wife, who had died. After the recitation was over the farmer asked: 'Do you think my wife will gain merit from this?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_859 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_230,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_311,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_860,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_861 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "24. Reciting Sutras"^^xsd:string ;
    neo:id "3d8a4fb554c4160a0383b07213712b68"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "'Not only your wife but all sentient beings will benefit from the recitation of sutras,' answered the priest."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_862 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_297,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_530,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_860,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_863,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_864 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "24. Reciting Sutras"^^xsd:string ;
    neo:id "dc29f950f6c6acd040a3ffadb392fbd1"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "'If you say all sentient beings will benefit,' said the farmer, 'my wife may be very weak and others will take advantage of her, getting the benefit she should have. So please recite sutras just for her.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_865 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_311,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_548,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_858,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_866,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_867 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "24. Reciting Sutras"^^xsd:string ;
    neo:id "efd95e1e3a04fc64afc2374ce3aac68f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "The priest explained that it was the desire of a Buddhist to offer blessings and wish merit for every living being."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_868 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_860,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_863,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_869 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "24. Reciting Sutras"^^xsd:string ;
    neo:id "ca1a72bef5137d0afbe663c1f8261301"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "That is a fine teaching,' concluded the farmer, 'but please make one exception. I have a neighbor who is rough and mean to me. Just exclude him from all those sentient beings.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_870 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_266,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_871,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_872,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_873 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "25. Three Days More"^^xsd:string ;
    neo:id "6af68523c0a44bea7d241df2da1d7fff"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Suiwo, the disciple of Hakuin, was a good teacher. During one summer seclusion period, a pupil came to him from a southern island of Japan."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_874 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_220,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_871,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_875 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "25. Three Days More"^^xsd:string ;
    neo:id "6ac555ce58bffe926c3ceea412525668"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Suiwo gave him the problem: 'Hear the sound of one hand.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_876 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_725,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_871,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_877,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_878 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "25. Three Days More"^^xsd:string ;
    neo:id "810ac68a72e25bca6c9aa8360ede5c20"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "The pupil remained three years but could not pass this test. One night he came in tears to Suiwo. 'I must return south in shame and embarrassment,' he said, 'for I cannot solve my problem.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_879 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_139,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_503,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_725,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_871 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "25. Three Days More"^^xsd:string ;
    neo:id "a5b18d9903d754227657977be149d180"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "'Wait one week more and meditate constantly,' advised Suiwo. Still no enlightenment came to the pupil. Try for another week,' said Suiwo. The pupil obeyed, but in vain."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_880 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_139,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_503,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_641,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_871 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "25. Three Days More"^^xsd:string ;
    neo:id "7bba7f544e8478efb5ee503722256472"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "'Still another week.' Yet this was of no avail. In despair the student begged to be released, but Suiwo requested another meditation of five day. They were without result. Then he said: 'Mediate for three day longer, then if you fail to attain enlightenment, you had better kill yourself.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_881 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_725,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_882 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "25. Three Days More"^^xsd:string ;
    neo:id "715db7ca9fbff8528fbe30f5d2222fdf"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "On the second day the pupil was enlightened."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_883 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_480,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_884,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_885,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_886,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_887 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "26. Trading Dialogue for Lodging"^^xsd:string ;
    neo:id "7bd7176508841b660b997355ba8616a1"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Provided he makes and wins an argument about Buddhism with those who live there any wandering monk can remain in a Zen temple. If he is defeated, he has to move on."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_888 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_22,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_340,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_391,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_889,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_890,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_891,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_892,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_893 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "26. Trading Dialogue for Lodging"^^xsd:string ;
    neo:id "a28c1c31e9d874fa6a417883b9c8d12e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "In a temple in the northern part of Japan two brothers monks were dwelling together. The elder one was learned, but the younger one was stupid and had but one eye."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_89 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_90,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_91,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_92,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_93,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_94,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_95 ;
