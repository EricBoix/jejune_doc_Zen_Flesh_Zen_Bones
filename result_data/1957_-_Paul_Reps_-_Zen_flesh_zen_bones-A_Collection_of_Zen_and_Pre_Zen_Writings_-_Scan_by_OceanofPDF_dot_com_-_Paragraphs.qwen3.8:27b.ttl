    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 47 ;
    neo:text "Blessed one, as senses are absorbed in heart, reach the center of the lotus."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3285 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3286,
