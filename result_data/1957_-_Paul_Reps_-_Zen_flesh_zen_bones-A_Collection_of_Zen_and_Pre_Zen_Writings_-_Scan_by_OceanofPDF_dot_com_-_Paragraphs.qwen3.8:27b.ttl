    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 45 ;
    neo:text "Feel your substance, bones, flesh, blood, saturated with cosmic essence."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3278 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3279,
