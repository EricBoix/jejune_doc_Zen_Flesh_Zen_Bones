    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "19. Everyday Life Is the Path"^^xsd:string ;
    neo:id "d1a2ff76b645d8ff6166fa271e0c1cf7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "Nansen said: \"The path does not belong to the perception world, neither does it belong to the nonperception world. Cognition is a delusion and noncognition is senseless. If you want to reach the true path beyond doubt, place yourself in the same freedom as sky. You name it neither good nor not-good.\""^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2526 a neo:Document ;
