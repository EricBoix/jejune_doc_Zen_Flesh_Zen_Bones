    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "79b9bc0adb297335ec42954b37cee242"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 43 ;
    neo:text "Put mindstuff in such inexpressible fineness above, below, and in your heart."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_327 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_328,
