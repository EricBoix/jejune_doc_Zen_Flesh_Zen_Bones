    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "89. Zen Dialogue"^^xsd:string ;
    neo:id "0f3ff0643090f5fc4fa0037631ff9244"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "'Tomorrow morning,' the teacher told him, 'when you meet that little fellow, ask him the same question. He will give you the same answer, and then you ask him: \"Suppose have no feet, then where are you going!\" That will fix him.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1979 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1975,
