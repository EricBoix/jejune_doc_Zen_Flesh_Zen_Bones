        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_350,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_351,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_352 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "6. No Loving-Kindness"^^xsd:string ;
    neo:id "9fd4e946043c5d05f683db36e4f1478e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "'An old tree grows on a cold rock in winter,' replied the monk somewhat poetically. 'Nowhere is there any warmth.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3480 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3481,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3482,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3483,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_370 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "bbb683bde9e3fa051dbf58635a2f70e1"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 101 ;
    neo:text "Toss attachment for body aside, realizing I am everywhere. One who is everywhere is joyous."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3484 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2053,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3485,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3486,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3487,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3488,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_530 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "38f7cf977ebd97d9642b7314f6bfab79"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 102 ;
    neo:text "Objects and desires exist in me as in others. So accepting, let them be translated."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3489 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_252,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3485,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3490,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3491,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3492,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3493,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3494 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "580ec33932354b8d62e42c0ae64a2e36"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 103 ;
    neo:text "The appreciation of objects and subjects is the same for an enlightened as for an unenlightened person. The former has one greatness: he remains in the subjective mood, not lost in things."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3495 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_115,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_121,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1772,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1791,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_691 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "ac85abda7ef6a16cee29b08fda29852c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 104 ;
    neo:text "Feel the consciousness of each person as your own consciousness. So, leaving aside concern for self, become each being."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3496 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3497,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3498,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3499 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "d641896da9db4ed0b80547ba3641da74"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 105 ;
    neo:text "Thinking no thing, will limited-self unlimit."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3500 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3438,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3501,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3502 ;
