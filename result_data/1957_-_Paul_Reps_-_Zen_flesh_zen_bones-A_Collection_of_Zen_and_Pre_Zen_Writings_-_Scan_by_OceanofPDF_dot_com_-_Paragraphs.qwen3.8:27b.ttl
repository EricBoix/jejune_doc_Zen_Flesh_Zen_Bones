    neo:id "a4080358f9a6d70e11930aa96a3979ec"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Gudo was the emperor's teacher of his time. Nevertheless, he used to travel done as a wandering mendicant. Once when he was on his way to Edo, the cultural and political center of the shogunate, he approached a little village mad Takenaka."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1981 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_537,
