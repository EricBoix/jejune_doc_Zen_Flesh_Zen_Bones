    neo:id "72c97de05952a471fdb915630df34c6b"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "This day will not come again."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1010 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1007,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1011 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "32. Inch Time Foot Gem"^^xsd:string ;
    neo:id "17fadfd67a560c060f21f43d2076e7d8"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "Each minute is worth a priceless gem."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1012 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1013,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1014,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1015,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_230,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_391 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "33. Mokusen's Hand"^^xsd:string ;
    neo:id "92d1ac3d09c29939a6f0c4574670c479"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Mokusen Hiki was living in a temple in the province of Tamba. One of his adherents complained of the stinginess of his wife. Mokusen visited the adherent's wife and showed her his clenched fist before her face."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1016 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1017,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1018 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "33. Mokusen's Hand"^^xsd:string ;
    neo:id "6d0d692f0de3640112ddff3a3a5b74c0"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "'What do you mean by that?' asked the surprised woman."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1019 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1020,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_355 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "33. Mokusen's Hand"^^xsd:string ;
    neo:id "6ffe4ef62e4e40708bd6a9e5c87a38ec"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "'Suppose my fist were always like that. What would you call it?' he asked."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_102 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_103 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "Foreword"^^xsd:string ;
    neo:id "a4601c055947f2aca75dac711b637d55"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:text "PAUL REPS"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1021 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_213 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "33. Mokusen's Hand"^^xsd:string ;
    neo:id "45b1d3769ad25ae126204cf977a8a210"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "'Deformed,' replied the woman."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1022 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_329,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_355 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "33. Mokusen's Hand"^^xsd:string ;
    neo:id "becf3577fb23c478b933060698873b68"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "Then he opened his hand flat in her face and asked: 'Suppose it were always like that. What then?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1023 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1024,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1025 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "33. Mokusen's Hand"^^xsd:string ;
    neo:id "ee67eb0da8dafcb52296c2c3885156be"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "'Another kind of deformity,' said the wife."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1026 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1027,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_230 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "33. Mokusen's Hand"^^xsd:string ;
    neo:id "2971d42e54a17b7a46fd3810b009ea22"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "'If you understand that much,' finished Mokusen, 'you are a good wife.' Then he left."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1028 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_221,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_230 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "33. Mokusen's Hand"^^xsd:string ;
    neo:id "288a8dbe3b93a5d378119244885b6731"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "After his visit, this wife helped her husband to distribute as well as to save."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1029 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1030,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1031,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1032,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1033,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "34. A Smile in His Lifetime"^^xsd:string ;
    neo:id "b0f983b5914117d392ab11b4f7acca3c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Mokugen was never known to smile until his last day on earth. When his time came to pass away he said to his faithful ones: 'You have studied under me for more than ten years. Show me your real interpretation of Zen. Whoever expresses this most clearly shall be my successor and receive my robe and bowl.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1034 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1030,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_642 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "34. A Smile in His Lifetime"^^xsd:string ;
    neo:id "f2078b42ae0e3663b724012cfac86c15"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Everyone watched Mokugen's severe face but no one answered."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1035 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1036,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1037,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1038,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1039,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_178 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "34. A Smile in His Lifetime"^^xsd:string ;
    neo:id "e9e68e711fbd1b07bdc80763274a48ba"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "Encho, a disciple who bad been with his teacher for a long time, moved near the bedside. He pushed forward the medicine cup a few inches. This was his answer to the command."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_104 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_103,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_34 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "10 BULLS"^^xsd:string ;
    neo:id "ad1bb71b51ca54164cb449c2e5fcff0d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Transcribed by Nyogen Senzaki and Paul Reps"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1040 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_178 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "34. A Smile in His Lifetime"^^xsd:string ;
    neo:id "fd3347b8f884421dd398646b97b3e4e9"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "The teacher's face became even more severe. 'Is that all you understand?' he asked."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1041 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1030,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1031,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1032,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1036,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_190 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "34. A Smile in His Lifetime"^^xsd:string ;
    neo:id "96cc648724c8d0d04064161eda0e714c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "Encho reached out and moved the cup back again. A beautiful smile broke ova the features of Mokugen. 'You rascal,' he told Encho. 'You worked with me ten years and have not yet seen my whole body. Take the robe and bowl. They belong to you.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1042 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1043,
