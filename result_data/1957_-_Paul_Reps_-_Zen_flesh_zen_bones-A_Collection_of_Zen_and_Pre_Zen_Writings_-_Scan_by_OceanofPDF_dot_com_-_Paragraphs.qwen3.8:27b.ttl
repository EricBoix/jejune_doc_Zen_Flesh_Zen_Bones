    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 128 ;
    neo:text "I am existing. This is mine. This is this. 0 Beloved, even in such know illimitably. 107. This consciousness is the spirit of guidance of each one. Be this one."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3580 a neo:Document ;
