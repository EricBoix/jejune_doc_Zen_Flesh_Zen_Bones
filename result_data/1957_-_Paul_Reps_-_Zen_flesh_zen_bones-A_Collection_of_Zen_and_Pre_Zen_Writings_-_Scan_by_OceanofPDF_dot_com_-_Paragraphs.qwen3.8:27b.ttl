    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Joshu asked Nansen: \"What is the path?\""^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2510 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2425,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2511 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "19. Everyday Life Is the Path"^^xsd:string ;
    neo:id "9912230dcf2910a56424eec20ea7264c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Nansen said: \"Everyday life is the path.\""^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2512 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_680 ;
