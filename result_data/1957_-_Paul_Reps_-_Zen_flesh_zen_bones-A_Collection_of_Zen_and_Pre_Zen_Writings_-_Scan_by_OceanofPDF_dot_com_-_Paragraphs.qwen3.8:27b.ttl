    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 129 ;
    neo:text "Here is a sphere of change, change, change. Through change consume change."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3583 a neo:Document ;
