    neo:id "81092280286d727c2120dbb7a26f03b3"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "Daiju was enlightened! Ever after he urged his friends:"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_944 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_940,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_945 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "28. Open Your Own Treasure House"^^xsd:string ;
    neo:id "71364a03edc6a70b75e55841062be1b8"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "'Open your own treasure house and use those treasures.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_946 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_139,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_947,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_948,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_949 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "29. No Water, No Moon"^^xsd:string ;
    neo:id "7dbb99940a7b075af6c188213e522535"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "When the nun Chiyono studied Zen under Bukko of Engarku she was unable to attain the fruits of meditation for a long time."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_950 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_947,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_951,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_952,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_953,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_954,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_955 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "29. No Water, No Moon"^^xsd:string ;
    neo:id "cfde6375d9853d644816928436a194ff"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "At last one moonlit night she was carrying water in an old pail bound with bamboo. The bamboo broke and the bottom fell out of the pail, and at that moment Chiyono was set free!"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_956 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_275,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_957 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "29. No Water, No Moon"^^xsd:string ;
    neo:id "a84e37bcb723634f0155c1689fba0a69"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "In commemoration, she wrote a poem:"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_958 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_370,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_952 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "29. No Water, No Moon"^^xsd:string ;
    neo:id "477548c9f5fbdd9187fd164be80d5e1c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "In this way and that I tried to save the old pail"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_959 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_960,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_961,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_962 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "29. No Water, No Moon"^^xsd:string ;
    neo:id "b69008fb3c2987de0b6d2a64a54d43cd"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "Since the bamboo strip was weakening and about to break"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_96 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_100,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_101,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_85,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_86,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_97,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_98,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_99 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "Foreword"^^xsd:string ;
    neo:id "5380bf18eed2b28812f3653045827bef"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 18 ;
    neo:text "The problem of our mind, relating conscious to preconscious awareness takes us deep into everyday living. Dare we open our doors to the source of am being? What are flesh and bones for?"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_963 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_955,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_964 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "29. No Water, No Moon"^^xsd:string ;
    neo:id "40330411ffb80ecaa612353b04c43345"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "Until at last the bottom fell out."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_965 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_951,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_966 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "29. No Water, No Moon"^^xsd:string ;
    neo:id "a0f73cb827d3247582b9e6f3e0af38e5"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "No more water in the Pail!"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_967 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_420,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_951 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "29. No Water, No Moon"^^xsd:string ;
    neo:id "b53acb083c10be90861feba83cf745cb"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "No more moon in the water!"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_968 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_185,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_241,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_969,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_970,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_971 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "30. Calling Card"^^xsd:string ;
    neo:id "26221d726960138399373fd8a53f589b"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Keichu, the great Zen teacher of the Meiji era, was the head of Tofuku, a cathedral in Kyoto. One day the governor of Kyoto called upon him for the first time."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_972 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_241,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_366,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_973,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_974 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "30. Calling Card"^^xsd:string ;
    neo:id "34d6bd40edc3b75ee2938cda81184233"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "His attendant presented the card of the governor, which read: Kitagaki, Governor of Kyoto."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_975 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_366,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_969,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_976 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "30. Calling Card"^^xsd:string ;
    neo:id "5892e0903004eaba63da050cb728f46f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "'I have no business with such a fellow.' said Keichu to his attendant. 'Tell him to get out of here.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_977 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_178,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_366,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_971,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_974,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_978,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_979 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "30. Calling Card"^^xsd:string ;
    neo:id "875b7133c29b00c93ccd28decf25431b"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "The attendant carried the card back with apologies. 'That was my error,' said the governor and with a pencil he scratched out the words Governor of Kyoto. 'Ask your teacher again.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_980 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_178,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_973,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_974 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "30. Calling Card"^^xsd:string ;
    neo:id "666cc3452f204a49164a8fe9d3ee8f92"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "'Oh, is that Kitagaki?' exclaimed the teacher when he saw the card. 'I want to see that fellow.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_981 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_445,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_982,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_983,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_984,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_985 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "31. Everything is Best"^^xsd:string ;
    neo:id "7db210e4e1997fd49e156b3ef5dc7862"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "When Banzan was walking through a market he overheard a conversation between a butcher and his customer."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_986 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_987,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_988 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "31. Everything is Best"^^xsd:string ;
    neo:id "49b67db6e2f64465f4553f3bfe998607"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "'Give me the best piece of meat you have,' said the customer."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_989 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_988,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_990,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_991 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "31. Everything is Best"^^xsd:string ;
    neo:id "fb06f05d84c07a39856f48e9fccc3286"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "'Everything in my shop is the best,' replied me butcher. 'You cannot find here any piece of meat that is not the best.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_992 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_503,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_982 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "31. Everything is Best"^^xsd:string ;
    neo:id "dd30af12b90c4fbc56eb35c322da66d3"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "At these words Banzan became enlightened."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_993 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_307,
