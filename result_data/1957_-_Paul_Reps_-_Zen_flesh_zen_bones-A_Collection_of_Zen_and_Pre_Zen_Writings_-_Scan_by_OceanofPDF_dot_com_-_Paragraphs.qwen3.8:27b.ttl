        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_603 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "10 BULLS"^^xsd:string ;
    neo:h3 "1. The Search for the Bull"^^xsd:string ;
    neo:id "30e72d3ef2bbcda70d97834e77ec13dd"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "Comment: The bull never has been lost. What need is there to search? Only because of separation from my true nature, I fail to find him. In the confusion of the senses I lose even his tracks. Far from home, I see many crossroads, but which way is the right one I know not. Greed and fear, good and bad, entangle me."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2999 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1220,
