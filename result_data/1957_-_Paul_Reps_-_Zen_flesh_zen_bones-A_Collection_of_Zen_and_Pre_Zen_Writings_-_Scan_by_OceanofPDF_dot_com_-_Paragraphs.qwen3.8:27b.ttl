    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 119 ;
    neo:text "Feel an object before you. Feel the absence of all other objects but this one. Then, leaving aside the object-feeling and the absence-feeling, realize."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3553 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3199,
