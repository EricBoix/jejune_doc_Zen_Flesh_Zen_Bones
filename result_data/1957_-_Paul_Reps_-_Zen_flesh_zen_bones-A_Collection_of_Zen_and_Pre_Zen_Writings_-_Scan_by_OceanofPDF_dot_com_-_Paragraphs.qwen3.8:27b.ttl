    neo:h3 "89. Zen Dialogue"^^xsd:string ;
    neo:id "830e5497c10ddacb83b88fecd87482bc"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:text "'Ask him where he is going if there is no wind,' suggested the teacher."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1985 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1980 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "89. Zen Dialogue"^^xsd:string ;
    neo:id "93f3d5be9f39e798cb31c80639d67ae2"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:text "The next day the children met a third time."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1986 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1972,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1975 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "89. Zen Dialogue"^^xsd:string ;
    neo:id "af72b084ca6ff75352646aca9ee0ce28"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:text "'Where are you going?' asked the first child."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1987 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1970,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_537,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_983 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "89. Zen Dialogue"^^xsd:string ;
    neo:id "04ba02b73e10c8dc422473311a1ab3ba"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:text "'I am going to market to buy vegetables,' the other replied."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1988 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1811,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1989 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "90. The Last Rap"^^xsd:string ;
    neo:id "f09b646406f59733f7bdb10275109b5e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Tangen had studied with Sengai since childhood. When he was twenty he wanted to have his teacher and visit others for comparative study, but Sengai would not permit this. Every time Tangen suggested it, Sengai would give him a rap on the head."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1990 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1811,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1989,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_895 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "90. The Last Rap"^^xsd:string ;
    neo:id "a94d6a0dfc06ac2cb6a2994033bf10a1"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Finally Tangen asked an elder brother to coax permission from Sengai. This the brother did and then reported to Tangen:"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1991 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1992,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_261,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_370 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "90. The Last Rap"^^xsd:string ;
    neo:id "a63ff238d6793a7dfa6b11d209443fbb"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "'It is arranged. I have fixed it for you to start on your pilgrimage at once.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1993 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1811,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1989 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "90. The Last Rap"^^xsd:string ;
    neo:id "8e262c400a34f31b714a8602861ed023"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "Tangen went to Sengai to thank him for his permission. The master answered by giving him another rap."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1994 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1811,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1989,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1995 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "90. The Last Rap"^^xsd:string ;
    neo:id "6edad8b3a3d44295d0dc005414042a69"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "When Tangen related this to his elder brother the other said: 'What is the matter? Sengai has no business giving permission and then changing his mind. I will tell him so.' And off he went to see the teacher."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1996 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1811,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_220 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "90. The Last Rap"^^xsd:string ;
    neo:id "e96afc736c75a2e3a9e3db4770719fc6"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "'I did not cancel my permission,' said Sengai. 'I just wished to give him one last smack over the head, for when he returns he will be enlightened and I will not be able to reprimand him again.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1997 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1998,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1999 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "439d06c8c7c8c4fedd2b96152b65cc12"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Matajuro Yagyu was the son of a famous swordsman. His father, believing that his son's work was too mediocre to anticipate mastership, disowned him."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2000 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2001,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2002,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2003,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2004,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_290 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "185318b26c7256fd5f8f67b250c7f91e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "So Matajuro went to Mount Fuhra and there found the famous swordsman Banzo. But Banzo confirmed the father's judgment. 'You wish to learn swordsmanship under my guidance?' asked Banzo. 'You cannot fulfill the requirements.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2005 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2006,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2007,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_333 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "2b152d79c9a2e01baa287b15d06128e7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "'But if I work hard, how many years will it take me to be come a master?' persisted the youth."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2008 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2003 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "3f49f89f899794b13c0ec6fdd5ed2dc7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "'The rest of your life,' replied Banzo."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2009 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2001 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "29c737882fa69e7c0780d35f50011ef1"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "'I cannot wait that long,' explained Matajuro. 'I am willing to pass through any hardship if only you will teach me. If I become your devoted servant, how long might it be?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2012 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2003,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2013 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "47e605b68bc47b8877ef61e3a827a2d0"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "'Oh, maybe ten years,' Banzo relented."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2014 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2001,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2015 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "e6c1d8f2d3167261862c4344a8723a72"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "'My father is getting old, and soon I must take care of him,' continued Matajuro. 'If I work far more intensively, how long would it take me!'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2016 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2003 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "6b1b7a508bb5641250843a6a474b3757"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "'Oh, maybe thirty years.' said Banzo."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2018 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2001,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2019 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "e1cdb711d0c6f00d1f8f84abbb7722bd"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:text "'Why is that?' asked Matajuro. 'First you say ten and now thirty years. I will undergo any hardship to master this art in the shortest time!'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2020 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2003 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "26382d8e1761ecf90cdb93b9d4735ab4"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:text "'Well,' said Banzo, 'in that case you will have to remain with me for seventy years. A man in such a hurry as you are to get results seldom learns quickly.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2021 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2006,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2022 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "8ca48d52407e3d2990324e27b7c469f9"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:text "'Very well.' declared the youth, understanding at last that he was being rebuked for impatience, 'I agree.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2023 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1178,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1606,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1651,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2001,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2004,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2024,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_333,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_840,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_844 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "503d3a62f6b490a8863cc34dfaaf723d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:text "Matajuro was told never to speak of fencing and never to touch a sword. He cooked for his master, washed the dishes, made his bed, and cleaned the yard, cared for the garden, all without a word of swordsmanship."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2025 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2001,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2019,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2026 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "a5c225e1363f1d654add8c485561eafe"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 13 ;
    neo:text "Three years passed. Still Matajuro labored on. Thinking of his future he was sad. He had not even begun to learn the art to which he had devoted his life."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2027 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2003,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2028,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_220 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "91c4df52fc530f24130cbe83ec8f879a"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:text "But one day Banzo crept up behind him and gave him a terrific blow with a wooden sword."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2029 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2001,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2003,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2030 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "0e7fa226eec895b47115beff6584cc00"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:text "The following day, when Matajuro was cooking rice, Banzo, again sprang upon him unexpectedly."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2031 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2001,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2003,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2032 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "503046e4f32f0068d28c8e615da802e6"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:text "After that, day and night, Matajuro had to defend himself from unexpected thrusts. Not a moment passed in any day that he did not have to think of the taste of Banzo's sword."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2033 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2001,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2034,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_333,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_394 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "91. The Taste of Banzo's Sword"^^xsd:string ;
    neo:id "30396e1222f59427ce63f84dbba9e90d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 17 ;
    neo:text "He learned so rapidly he brought smiles to the face of his master. Matajuro became the greatest swordsman in the land."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2035 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2036,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_266,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_339,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_428 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "92. Fire-Poker Zen"^^xsd:string ;
    neo:id "f21862c34c330842f9e827d9a2f61111"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Hakuin used to tell his pupils about an old woman who had a teashop, praising her understanding of Zen. The pupils refused to believe what he told them and would go to the teashop to find out for themselves."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2037 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_188,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2038,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2039,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2040,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_213,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "92. Fire-Poker Zen"^^xsd:string ;
    neo:id "3f4ff8f27bf75ee4dd26a53007accdb7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Whenever the woman saw them coming she could tell it once whether they had come for tea or to look into her grasp of Zen. In the former case, she would serve them graciously. In the latter, she would beckon to the pupils to come behind her screen. The instant they obeyed, she would strike than with a fire-poker."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_204 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_199,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_205,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_206,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_207,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_208,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_209,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_210,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_211 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "2. Finding a Diamond on a Muddy Road"^^xsd:string ;
    neo:id "fd4c55e4b72959a6b2d2e4c9dbf4e436"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "It was evening and a heavy rain was falling. Gudo was thoroughly wet. His straw sandals were in pieces. At a farmhouse near the village he noticed four or five pairs of sandals in the window and decided to buy some dry ones."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2041 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1907,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2042,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_329 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "92. Fire-Poker Zen"^^xsd:string ;
    neo:id "4fa44f5f8e87241b36be57abbb2d614e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "Nine out of ten of them could not escape her beating."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2043 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1036,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2044,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2045,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2046,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2047,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_300 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "93. Storyteller's Zen"^^xsd:string ;
    neo:id "6d5fb97ac0812b9fc705b3a92d2769d8"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Encho was a famous storyteller. His tales of love stirred the hearts of his listeners. When he narrated a story of war, it was as if the listeners themselves were on the field of battle."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2048 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1036,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1605,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2049,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2050,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "93. Storyteller's Zen"^^xsd:string ;
    neo:id "ff4017584507505470b4aa758e1aac7b"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "One day Encho met Yamaoka Tesshu, a layman who had almost embraced master hood in Zen. 'I understand,' said Yamaoka, 'you are the best storyteller in our land and that you make people cry or laugh at will. Tell me my favorite story of the Peach Boy. When I was a little tot I used to sleep beside my mother, and she often related this legend. In the middle of the story I would fall asleep. Tell it to me just is my mother did.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2051 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1036,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1612 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "93. Storyteller's Zen"^^xsd:string ;
    neo:id "126d5774e5fee02dec52d0dfc009aef7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "Encho dared not attempt to do this. He requested time to study. Several months later he went to Yamaoka and said,"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2052 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_180,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2053,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_261,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_825 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "93. Storyteller's Zen"^^xsd:string ;
    neo:id "6d819555a908b266e2b412e64df9a89e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "'Please give me the opportunity to tell you the story."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2054 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1612 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "93. Storyteller's Zen"^^xsd:string ;
    neo:id "911efcad40ae6aaf66cbf6af5da62326"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "'Some other day,' answered Yamaoka."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2055 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1036,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1612,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2056 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "93. Storyteller's Zen"^^xsd:string ;
    neo:id "9f1c02b5d4783c8fd25b64002359e1a4"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "Encho was keenly disappointed. He studied further and tried again. Yamaoka rejected him many times. When Encho would start to talk Yamaoka would stop him, saying: 'You are not yet like my mother.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2057 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1036,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1612,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2058,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2059,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "93. Storyteller's Zen"^^xsd:string ;
    neo:id "b6a6a82831710bef24a1882e1a32fe59"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "It took Encho five years to be able to tell Yamaoka the legend as his mother had told it to him. In this way, Yamaoka imparted Zen to Encho."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2060 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_139,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1811,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2061,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_391,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_428 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "94. Midnight Excursion"^^xsd:string ;
    neo:id "4cabf93e6aa622953d14beff961bc9d3"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Many pupils were studying meditation under the Zen master Sengai. One of them used to arise at night, climb over the temple wall, and go to town on a pleasure jaunt."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2062 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1811,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2063,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2064,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2065,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_872 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "94. Midnight Excursion"^^xsd:string ;
    neo:id "6171b76690e52476c1ff4fa4cbdc4a47"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Sengai, inspecting the dormitory quarters, found this pupil missing one night and also discovered the high stool he had used to scale the wall. Sengai removed the stool and stood there in its place."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2066 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1811,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2067,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2068 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "94. Midnight Excursion"^^xsd:string ;
    neo:id "a6be91fb5ca635ce4c0a5c8f49aac58d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "When the wanderer returned, not knowing that Sengai was the stool he put his feet on the master's head and jumped down into the grounds. Discovering what he had done, he was aghast."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2069 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1811,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2070,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2071,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2072 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "94. Midnight Excursion"^^xsd:string ;
    neo:id "c17ad9b728610fd19061a3e2c93a449c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "Sengai said: 'It is very chilly in the early morning. Do be careful not to catch cold yourself.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2073 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_399,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_872 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "94. Midnight Excursion"^^xsd:string ;
    neo:id "288304423e20477d74bfe6df6f9e1ad3"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "The pupil never went out at night again."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2074 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2075,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_463,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_738 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "95. A Letter to a Dying Man"^^xsd:string ;
    neo:id "4f719e2360a6a2f8362e4295c4bc84e6"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Bassui wrote the following letter to one of his disciples who was about to die:"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2076 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1051,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2077,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2078,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2079,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2080,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2081,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2082,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2083,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2084,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2085,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_656 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "95. A Letter to a Dying Man"^^xsd:string ;
    neo:id "62a8c73e0d694c824bbc97b3680d3d51"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "The essence of your mind is not born so it will never die. It is not an existence, which is perishable. It is not an emptiness, which is a mere void. It has neither color nor form. It enjoys no pleasures and suffers no pain."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2086 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1729,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2077,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2087,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2088,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2089,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2090,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2091,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_248,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_97 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "95. A Letter to a Dying Man"^^xsd:string ;
    neo:id "9da30985735b90b4540a8b29fe67cef2"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "'I know you are very ill. Like a good Zen student, you are facing that sickness squarely. You may not know exactly who is suffering, but question yourself: What is the essence of this mind? Think only of this. You will need no more. Covet nothing. Your end which is endless is as a snowflake dissolving in the pure air.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2092 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2093,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2094,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2095,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2096 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "96.A Drop of Water"^^xsd:string ;
    neo:id "96e433031b1692cbe3b727df9711b6b7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "A Zen master named Gisan asked a young student to bring him a pail of water to cool his bath."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2097 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2096,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_535,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_633,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_951 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "96.A Drop of Water"^^xsd:string ;
    neo:id "f4e6e13fb0d69e079782155de0813525"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "The student brought the water and, after cooling the bath, threw on to the ground the little that was left over."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2098 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2099,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_220,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_391,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_76,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_951 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "96.A Drop of Water"^^xsd:string ;
    neo:id "190f7b43bde6b3cf06e7c9f65cd52455"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "'You dunce!' the master scolded him. 'Why didn't you give the rest of the water to the plants? What right have you to waste even a drop of water in this temple?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2100 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1874,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2094,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2101,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "96.A Drop of Water"^^xsd:string ;
    neo:id "5f46cb98cc72d2f9c9ddb95cbdf16779"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "The young student attained Zen in that instant. He changed his name to Tekisui, which means a drop of water."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2102 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2103,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2104,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_22,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_925,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_927 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "97. Teaching the Ultimate"^^xsd:string ;
    neo:id "d1e7d4d53dd8fda932b4e6d356fe655e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "In early times in Japan, bamboo-and-paper lanterns wee used with candles inside. A blind man, visiting a friend one night was offered a lantern to carry home with him."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2105 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2106,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2107,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_355,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_59 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "97. Teaching the Ultimate"^^xsd:string ;
    neo:id "9bccebec31e7219728913fa52d141af8"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "'I do not need a lantern,' he said. Darkness or light is all the same to me'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2108 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2106,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2109,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2110,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2111,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_261 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "97. Teaching the Ultimate"^^xsd:string ;
    neo:id "29a634e5273ce3d80647fbc392fdd4be"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "'I know you do not need a lantern to find your way,' his friend replied, 'but if you don't have one someone else may run into you. So you must take it.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2112 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2113,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2114,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2115 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "97. Teaching the Ultimate"^^xsd:string ;
    neo:id "7f616b1d6c0af567e7f6c3be808106a9"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "The blind man started off with the lantern and before he had walked very far someone ran squarely into him. 'Look out where you are going!' he exclaimed to the stranger. 'Can't you see this lantern?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2116 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2115,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2117,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_550 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "97. Teaching the Ultimate"^^xsd:string ;
    neo:id "de24f334c73387593e10b4fd4ecb23f6"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "'Your candle has burned out brother,' replied the stranger."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2119 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1055,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2120,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2121,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2122,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2123,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2124,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_907 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "98. Non-Attachment"^^xsd:string ;
    neo:id "4f86c708ed198a615fb4ea4ce9233273"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Kitano Gempo, abbot of Eihei temple was ninety-two years old when he passed away in the year 1933. He endeavored his whole life not to be attached to anything. As a wandering mendicant when he was twenty he happened to meet a traveler who smoked tobacco. As they walked together down a mountain road they stopped under a tree to rest. The traveler offered Kitano a smoke, which he accepted, as he was very hungry at the time."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_212 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_199,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_213,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_214,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_215,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_216,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_217 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "2. Finding a Diamond on a Muddy Road"^^xsd:string ;
    neo:id "5dc5343baeccfcc1ec63ee2321d1b174"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "The woman who offered him the sandals seeing how wet he was invited him to remain for the night in her home. Gudo accepted, thanking her. He entered and recited a sutra before the family shrine. He then was introduced to the woman's mother, and to her children. Observing that the entire family was depressed Gudo asked what was wrong."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2125 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2123,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2126,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_355,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_537 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "98. Non-Attachment"^^xsd:string ;
    neo:id "79d1c354c99eb246dfaa17de595d84ea"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "'How pleasant this smoking is,' he commented. The other gave him an extra pipe and tobacco and they parted."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2127 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_139,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2128,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2129 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "98. Non-Attachment"^^xsd:string ;
    neo:id "8d9380ada2be2223d8f5c9643fcd0a86"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "Kitano felt: 'Such pleasant things may disturb meditation. Before this goes too far, I will stop now.' So he threw the smoking outfit away."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2130 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_178,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2128,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2131,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2132,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_351,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_414,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_738,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_907 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "98. Non-Attachment"^^xsd:string ;
    neo:id "c36d8b77563222eeca58de43f716f536"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "When he was twenty-three years old he studied I-King, the profoundest doctrine of the universe. It was winter at the time and he needed some heavy clothes. He wrote to his teacher, who lived a hundred miles away, telling him of his need, and gave the letter to a traveler to deliver. Almost the whole winter passed and neither answer nor clothes arrived. So Kitano resorted to the prescience of I-King, which also teaches the art of divination, to determine whether or not his letter had miscarried. He found that this had been the case. A letter afterwards from his teacher made no mention of clothes."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2133 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_139,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2128,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2131,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2134 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "98. Non-Attachment"^^xsd:string ;
    neo:id "c49011cb529f6dff2323b2c1df816dc8"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "'If I perform such accurate determinative work with I-King, I may neglect my meditation,' felt Kitano. So he gave up this marvelous teaching and never resorted to its powers again."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2135 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_178,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2128,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2136,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2137,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_307,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_448 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "98. Non-Attachment"^^xsd:string ;
    neo:id "06d5edba9c17aff7047b6e00cc795f6f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "When he was twenty-eight he studied Chinese calligraphy and poetry. He grew so skilful in these arts that his teacher praised him. Kitano mused: 'If I don't stop now, I'll be a poet not a Zen teacher.' So he never wrote another poem."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2138 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1159,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1164,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1165,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_171,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2030,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2139,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_927 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "99. Tasui's Vinegar"^^xsd:string ;
    neo:id "1afb3148cea2d7e72cb520c5b0ab4dfc"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Tosui was the Zen master who left the formalism of temples to live under a bridge with beggars. When he was getting very old, a friend helped him to earn his living without begging. He showed Tosui how to collect rice and manufacture vinegar from it and Tosui did this until he passed away."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2140 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1159,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1169,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2065,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2141,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2142,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_341,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_90 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "99. Tasui's Vinegar"^^xsd:string ;
    neo:id "730fe7a4cc87d561c4f9932acf34edc7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "While Tosui was making vinegar, one of the beggars gave him a picture of the Buddha. Tosui hung it on the wall of his hut and put a sign beside it. The sign read:"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2143 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1440,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2144,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2145,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2146,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2147 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "99. Tasui's Vinegar"^^xsd:string ;
    neo:id "cbd0ba0db559d4df0fe27ef0ae273faa"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "'Mr. Amida Buddha: This little loom is quite narrow. I can let you remain as a transient. But don't think I am asking you to help me to be reborn in your paradise.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2148 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2149,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2150,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_463 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "100. The Silent Temple"^^xsd:string ;
    neo:id "a92d5117513b30ae8efd86b61b02c6f1"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Shochi was a one-eyed teacher of Zen, sparkling with enlightenment. He taught his disciple in Tofuku temple."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2151 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2152,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_391,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_399,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_899 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "100. The Silent Temple"^^xsd:string ;
    neo:id "55251f8f2dd0500e59d6a7c2dd6060fa"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Day and night the whole temple stood in silence. There was no sound at all."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2153 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2154,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_297,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_312,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_428,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_808 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "100. The Silent Temple"^^xsd:string ;
    neo:id "4175df29d4655e971a75f096b8b5df5c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "Even the reciting of sutras was abolished by the teacher. His pupils had nothing to do but meditate."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2155 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2156,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2157,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2158,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_297,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_656 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "100. The Silent Temple"^^xsd:string ;
    neo:id "f0000885f20e1442d7b80b1c348d771c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "What the master passed away, an old neighbor heard the ringing of bells and the recitation of sutras. Then she knew Shoichi had gone."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2159 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_90 ;
