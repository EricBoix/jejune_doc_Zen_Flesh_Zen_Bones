    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 106 ;
    neo:text "Believe omniscient, omnipotent, pervading."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3503 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1744,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3504,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3505,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_393,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_852,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_951 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "f25d4bdc0136d7611cee3c5babdaea7a"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 107 ;
    neo:text "As waves come with water and flames with fire, so the universal waves with us."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3506 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3507,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3508,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3509,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3510 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "8cfdf404051200de0316a4a9ab0165a6"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 108 ;
    neo:text "Roam about until exhausted and then, dropping to the ground, in this dropping be whole."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3511 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2990,
