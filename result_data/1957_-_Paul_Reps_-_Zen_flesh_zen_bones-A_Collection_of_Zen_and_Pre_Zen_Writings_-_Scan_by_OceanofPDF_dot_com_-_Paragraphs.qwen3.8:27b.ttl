        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3088,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_370,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_410,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_47,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_899,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_951 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "10 BULLS"^^xsd:string ;
    neo:h3 "9. Reaching the Source"^^xsd:string ;
    neo:id "20a2c23f5d140772fa4ccb48586c69f8"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Comment: From the beginning, truth is clear. Poised in silence, I observe the forms of integration and disintegration. One who is not attached to \"form\" need not be \"reformed.\" The water is emerald, the mountain is indigo, and I see that which is creating and that which is destroying."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3089 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1665,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_169,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3090,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3091,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3092,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3093,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_370,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_414 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "10 BULLS"^^xsd:string ;
    neo:h3 "10. In the World"^^xsd:string ;
    neo:id "23d005e293559f8c100119ce00d78bc6"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Barefooted and naked of breast, I mingle with the people of the world. My clothes are ragged and dust-laden, and I am ever blissful. I use no magic to extend my life; Now, before me, the dead trees become alive."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3094 a neo:Document ;
