    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "The girl returned and related what he had said."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3540 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2083,
