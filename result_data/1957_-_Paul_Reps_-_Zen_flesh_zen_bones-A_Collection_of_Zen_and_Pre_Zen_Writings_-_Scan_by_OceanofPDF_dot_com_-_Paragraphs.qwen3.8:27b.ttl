    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Comment: Inside my gate, a thousand sages do not know me. The beauty of my garden is invisible. Why should one search for the footprints of the patriarchs? I go to the market place with my wine bottle and return home with my staff. I visit the wineshop and the market, and everyone I look upon becomes enlightened."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_310 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_311,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_312,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_313 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "4. Obedience"^^xsd:string ;
    neo:id "367405cf9ddbc2152f6b54fe47a5ce83"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "Proudly the priest pushed his way through the crowd to the teacher."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3104 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_103 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "45d703864883835058379f645f4e4225"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Transcribed by Paul Reps"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3105 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_30,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3106,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3107,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_90 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "566ec4d789de5aa6a7b7a417174460db"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Zen is nothing new, neither is it anything old. Long before Buddha was born the search was on in India, as the present work shows."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3108 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_13,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_168,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_22,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2753,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3109,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3110,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3111,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_40,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_513,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_697,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_90 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "bcbfdc04ab5c6301cbf330aff13e9e04"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "Long after man has forgotten such words as Zen and Buddha, satori and koan, China and Japan and America--still the search will go on, still Zen will be seen even in flower, and grass-blade, before the sun."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3112 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_127,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3113,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3114 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "d2c166fb455096a3c7a6d6dfb3a21555"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "The following is adapted from the preface to the first version in English of this ancient work."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3115 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_29,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3116,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3117,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_35 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "8884b911bf6bc8544ab766e7493d5d14"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "Wandering in the ineffable beauty of Kashmir, above Srinagar I come upon the hermitage of Lakshmanjoo."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3118 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1651,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1733,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3119,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3120,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3121,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3122,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3123,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3124,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_951 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "ea6b6857566f4f4b4e801b8338500791"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "It overlooks green rice fields, the garden, of Shalimar and Nishat Bagh, lakes fringed with lotus. Water streams down from a mountaintop."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3125 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3126,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3127,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3128,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_35 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "19ec57bc165b6f7821f0c9650a144c9d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "Here Lakshmanjoo--tall, full bodied, shining--welcomes me. He shares with me this ancient teaching from the Vigyan Bhairava and Sochanda Tantra, both written about four thousand years ago, and from Malini Vijaya Tantra, probably another thousand years older yet. It is an ancient teaching, copied and recopied countless times, and from it Lakshmanjoo has made the beginning of an English version. I transcribe it eleven more times to get it into the form given here."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3129 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_121,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2315,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3130,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3131,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3132,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3133,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3134,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_35 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "2a66db0e698d0c5d05411906eb87fbe7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "Shiva first chanted it to his consort Devi in a language of love we have yet to learn. It is about the Immanent experience. It presents 112 ways to open the invisible door of consciousness. I see Lakshmanjoo gives his life to its practicing."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3135 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3136,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3137,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3138,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3139,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3140 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "0019c98f24b9a175e9537e254c7d746f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:text "Some of the ways may appear redundant, yet each differs from any other. Some may seem simple, yet any one requires constant dedication even to test it."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_314 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_294 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "4. Obedience"^^xsd:string ;
    neo:id "01f459ecec600d223921ff3190f85646"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "Bankei smiled. 'Come over to my left side.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3141 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_24,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2541,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3142,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3143,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3144,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3145,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3146,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3147,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3148,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3149 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "ebeaf02d2265717622b081ca791f6c61"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:text "Machines, ledgers, dancers, athletes balance. Just as centering or balance augments various skills, so it may awareness. As an experiment, try standing equally on both feet; then imagine you are shifting your balance slightly from foot to foot: just as balance centers, do you."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3150 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_121,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2285,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_261 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "c409e3c4a99e1fa6519330e895c5cc85"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:text "If we are conscious in part, this implies more inclusive consciousness. Have you a hand? Yes. That you know without doubt. But until asked the question were you cognizant of the hand apart?"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3151 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_134,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_137,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2178,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_290,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3152,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3153,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3154,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3155,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3156,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3157,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3158,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_70,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_90 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "fbb5e2aa12937f842779304e18e2797c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:text "Surely men as inspiritors, known and unknown to the world, have shared a common uncommon discovery. The Tao of Lao-tse, Nirvana of Buddha, Jehovah of Moses, the Father of Jesus, the Allah of Mohammed -- all point to the experience. No-thing-ness, spirit--once touched, the whole life clears."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3159 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3131 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "37c68163a9b9fe25cab8d5c5208256da"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 13 ;
    neo:text "DEVI SAYS:"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_316 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_317 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "4. Obedience"^^xsd:string ;
    neo:id "ac99b70a5a7b2cf4f7824f1c9bc6798a"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "The priest obeyed."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3160 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3130,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_71 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "4b08fd713d656731c60091f445c55b10"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:text "O Shiva, what is your reality?"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3161 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_135 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "ee15c315cb5c0b04b9d2547543349ce7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:text "What is this wonder-filled universe?"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3162 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3163 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "3854775abb01458c071aa8ba084a1b24"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:text "What constitutes seed?"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3164 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3165 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "efee262b21b06b3facc3f4bb1d8192c9"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 17 ;
    neo:text "Who centers the universal wheel?"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3166 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3167,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3168 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "ff44f4f151faf350ca770e7118e16df0"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 18 ;
    neo:text "What is this life beyond form pervading forms?"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3169 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1005,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1733,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3170,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3171,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3172 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "eb8d08b641599b95173686909a092c87"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:text "How may we enter it fully, above space and time, names and descriptions?"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3173 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3174 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "20b09009cc7c3787662b77ccb9134ab5"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:text "Let my doubts be cleared!"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3175 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3130 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "f492292dfd5d61527510808530684567"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 21 ;
    neo:text "SHIVA REPLIES:"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3176 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_135,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3130,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3131,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3177,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3178,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_943 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "4bf9ea044d14ffc908b0fcf6fc0aa1a7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 22 ;
    neo:text "[Devi, though already enlightened, has asked the foregoing questions so others through the universe might receive Shiva's instructions. Now follow Shiva's reply, giving the 112 ways.]"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3179 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_137,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3180,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3181,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3182,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3183,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3184 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "2fff9ccddb3214f616dba91c788a609f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 23 ;
    neo:text "Radiant one, this experience may dawn between two breaths. After breath comes in (down) and just before turning up (out) -- the beneficence."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_318 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_294 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "4. Obedience"^^xsd:string ;
    neo:id "70e33deea200bb33171fd3a936a02a32"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "'No,' said Bankei, 'we may talk better if you are on the right side. Step over here.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3185 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3186,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3187,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3188,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3189,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3190,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3191 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "44b683ab58686ac404bd125642467da5"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 24 ;
    neo:text "As breath turns from down to up, and again as breath curves from up to down--through both these turns, realize."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3192 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3193,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3194,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3195 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "6faa5fbd99df7efb3c46dfbf1dcab085"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 25 ;
    neo:text "Or, whenever inbreath and outbreath fuse, at this instant touch the energyless energy-filled center."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3196 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3186,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3197,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3198,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3199 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "3617e0fa722817bd053d40ed0482a492"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 26 ;
    neo:text "Or, when breath is all out (up) and stopped of itself, or all in (down) and stopped--in such universal pause, one's small self vanishes. This is difficult only for the impure."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_320 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_311,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_321 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "4. Obedience"^^xsd:string ;
    neo:id "58e731a4c052488f4e0fec87b165fc5d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:text "The priest proudly stepped over to the right."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3200 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3201,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3202,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3203,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3204,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3205 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "935adbb23f08174e0abd1bf80a159b9a"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 27 ;
    neo:text "Consider your essence as light rays rising from center to center up the vertebrae, and so rises livingness in you."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3206 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2390,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3207 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "b621e6b89d38143fb8a59e5f618dad52"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 28 ;
    neo:text "Or in the spaces between, feel this as lightning."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3208 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2358,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3131,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3209,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3210,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3211,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_719,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_798 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "dff2b1ccced41e0b15d4d738671bacda"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 29 ;
    neo:text "Devi, imagine the Sanskrit letters in these honey-filled foci of awareness, first as letters, then more subtly as sounds, then as most subtle feeling. Then, leaving them aside, be free."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3212 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2083,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2609,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3213,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3214,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3215,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3216,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_59,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_97 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "9ac43aad7841588ae978fa541c9d8d53"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 30 ;
    neo:text "Attention between eyebrows, let mind be before thought. Let form fill with breath-essence to the top of the head, and there shower as light."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3217 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1312,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2065,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3170,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3218,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3219,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3220,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3221,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3222,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3223 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "0be2a21b3c6db1d73b3cb1795d14e7b4"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 31 ;
    neo:text "Or, imagine the five-colored circles of the peacock tail to be your five senses in illimitable space. Now let their beauty melt within. Similarly, at any point in space or on a wall -- until the point dissolves. Then your wish for another comes true."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_322 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_294 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "4. Obedience"^^xsd:string ;
    neo:id "c26fcaf1ae6c0c0354baff28ed3b9e2e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:text "'You see,' observed Bankei, 'you are obeying me and I think you are a very gentle person. Now sit down and listen.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3224 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_141,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3225 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "b7d532cc4046dcca6244aead62a3968e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 32 ;
    neo:text "Eyes closed, see your inner being in detail. Thus see your true nature."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3226 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3213,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3227,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3228,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3229,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3230 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "411eee25fce55abb6653573b737bc908"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 33 ;
    neo:text "Place your whole attention in the nerve, delicate as the lotus thread, in the center of your spinal column. In such be transformed."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3231 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2738,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3232,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3233,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3234 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "019bd85c4ce38566f1a9a0d26d575441"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 34 ;
    neo:text "Closing the seven openings of the head with your hands, a space between your eyes becomes all-inclusive."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3235 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2290,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3236,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3237,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3238,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3239 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "a7a0b6387dac9ef7ebfe528e98bf953c"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 35 ;
    neo:text "Touching eyeballs as a feather, lightness between them opens into heart and there permeates the cosmos."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_324 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_139,
