    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 120 ;
    neo:text "The purity of other teachings is as impurity to us. In reality know nothing as pure or impure."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3558 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_115,
