        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2506,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "18. Tozan's Three Pounds"^^xsd:string ;
    neo:id "1a357747e80ebe548296cad75dd733b5"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "Mumon's comment: Old Tozan's Zen is like a clam. The minute the shell opens you see the whole inside. However, I want to ask you: Do you see the real Tozan?"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2507 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1289,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1793,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1794,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2502,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2508,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_48,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_49,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_97 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "18. Tozan's Three Pounds"^^xsd:string ;
    neo:id "9c3ab65bf652da6650d20ded136f36c4"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "Three pounds of flax in front of your nose, Close enough, and mind is still closer. Whoever talks about affirmation and negation Lives in the right and wrong region."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2509 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2425,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_680 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "THE GATELESS GATE"^^xsd:string ;
    neo:h3 "19. Everyday Life Is the Path"^^xsd:string ;
    neo:id "fa2a35ec6a3856f347c7b5603d30e939"^^xsd:string ;
