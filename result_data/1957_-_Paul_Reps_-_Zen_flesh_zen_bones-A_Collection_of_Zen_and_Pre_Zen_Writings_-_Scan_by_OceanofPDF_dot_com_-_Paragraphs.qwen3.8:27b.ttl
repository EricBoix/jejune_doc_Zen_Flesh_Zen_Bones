    neo:id "b65624fabeb1a16cde5804ecbd920db4"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "A Zen master named Gettan lived in the latter part of the Tokugawa era. He used to say: ' There are three kinds of disciples: those who impart Zen to others, those who maintain the temples and shrines, and then there are the rice bags and the clothes-hangers.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1949 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1874,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_630 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "87. Three Kinds of Disciples"^^xsd:string ;
    neo:id "fd17e5842538f85782fd3a428a8c2088"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Gasan expressed the same idea. When he was studying under Tekisui, his teacher was very severe. Sometimes he even beat him. Other pupils would not stand this kind of teaching and quit. Gasan remained saying: 'A poor disciple utilizes a teacher's influence. A fair disciple admires a teacher's kindness. A good disciple grows strong under a teacher's discipline.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_195 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_184,
