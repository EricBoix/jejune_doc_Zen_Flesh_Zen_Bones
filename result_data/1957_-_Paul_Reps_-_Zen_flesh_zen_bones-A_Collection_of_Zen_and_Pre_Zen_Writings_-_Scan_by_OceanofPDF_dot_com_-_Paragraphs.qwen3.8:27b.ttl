    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 13 ;
    neo:text "grievous trouble. If you try to hold up the gate and door of a falling house, You also will be in trouble."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2501 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_2436,
