        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_197,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "1. A Cup of Tea"^^xsd:string ;
    neo:id "08cfb276a2330003eb2af8748a28dc69"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "'Like this cup,' Nan-in said. 'You are full of your own opinions and speculations. How can I show you Zen unless you first empty your cup? '"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1950 a neo:Document ;
