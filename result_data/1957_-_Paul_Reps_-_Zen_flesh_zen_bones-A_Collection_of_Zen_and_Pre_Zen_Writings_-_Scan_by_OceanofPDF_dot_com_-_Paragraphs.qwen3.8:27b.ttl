    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 49 ;
    neo:text "When in worldly activity, keep attentive between the two breaths, and so practicing, in a few days be born anew. [Lakshmanjoo says this is his favorite.]"^^xsd:string .

