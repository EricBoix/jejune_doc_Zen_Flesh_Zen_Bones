    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "6. No Loving-Kindness"^^xsd:string ;
    neo:id "b98c76f52179d82165d19c484fae5dad"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "'To think I fed that fellow for twenty years!' exclaimed the old woman in anger.' He showed no consideration for your need, no disposition to explain your condition. He need not have responded to passion, but at last he should have evidenced some compassion.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3562 a neo:Document ;
