    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 44 ;
    neo:text "Consider any area of your present form as limitlessly spacious."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3274 a neo:Document ;
