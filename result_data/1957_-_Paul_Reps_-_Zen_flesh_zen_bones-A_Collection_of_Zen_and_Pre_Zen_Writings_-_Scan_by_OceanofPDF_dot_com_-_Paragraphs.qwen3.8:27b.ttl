    neo:h3 "5. If You Love, Love Openly"^^xsd:string ;
    neo:id "e39a09ded1a35523b7f42685b073c2c2"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "One of them wrote her a love letter, insisting upon a private meeting."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3270 a neo:Document ;
