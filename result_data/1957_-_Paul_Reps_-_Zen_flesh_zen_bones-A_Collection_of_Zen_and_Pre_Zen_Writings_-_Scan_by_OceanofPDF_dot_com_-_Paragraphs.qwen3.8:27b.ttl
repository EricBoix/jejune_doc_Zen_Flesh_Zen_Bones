        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3516,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3517,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3518 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "e853cbc7bd9b0de431549c3d5407c987"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 110 ;
    neo:text "Listen while the ultimate mystical teaching is imparted: Eyes still, without winking, at once become absolutely free."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3519 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3245,
