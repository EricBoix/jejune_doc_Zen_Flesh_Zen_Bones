    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "0593fe89219c74d114a5a2b92af29c64"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 111 ;
    neo:text "Stopping ears by pressing and rectum by contracting, enter the sound of sound."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3523 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3524,
