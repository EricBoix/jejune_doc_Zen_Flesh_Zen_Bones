    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "Tanzan"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_376 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_377,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_378,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_379 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "7. Announcement"^^xsd:string ;
    neo:id "c99a7d99080ff5ace4b8c22e5f099931"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "27 July 1892."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_38 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_30,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_39,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_40,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_41,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_42,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_43,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_44 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "Foreword"^^xsd:string ;
    neo:id "7665e1e6b9a1c22a9acbef9962776e73"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "The first Zen patriarch Bodhidharma brought Zen to China from India in the sixth century. According to his biography recorded in the year 1004 by the Chinese teacher Dogen after nine years in China Bodhidharma wished to go home and gathered his disciples about him to test their apperception."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_380 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_185,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_381 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "8. Great Waves"^^xsd:string ;
    neo:id "70a77ea7731f18e96f4ad4060f2f0199"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "In the early days of the Meiji era there lived a well-known wrestler called O-nami, Great Waves."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_382 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_381,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_383,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_384,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_385 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "8. Great Waves"^^xsd:string ;
    neo:id "12a4855d62170a48fd14d7913bc155fc"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "O-nami was immensely strong and knew the art of wrestling. In his private bouts he defeated even his teacher, but in public he was so bashful that his own pupils threw him."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_386 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_267,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_381,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_387,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_388 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "8. Great Waves"^^xsd:string ;
    neo:id "88679b843dee6e16fe136d5f4c70a364"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "O-nami felt he should go to a Zen master for help. Hakuju, a wandering teacher, was stopping in a little temple nearby, so O-nami went to see him and told him of his trouble."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_389 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_312,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_390,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_391,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_392,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_393,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_394 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "8. Great Waves"^^xsd:string ;
    neo:id "5c7248cd365a131dd1dd5545dcd96e26"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "'Great Waves is your name,' the teacher advised,' so stay in this temple tonight. Imagine that you are those billows. You are no longer a wrestler who is afraid. You are those huge waves sweeping everything before them, swallowing all in their path. Do this and you will be the greatest wrestler in the land.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_395 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_139,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_312,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_381,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_393,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_396 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "8. Great Waves"^^xsd:string ;
    neo:id "4739c2a4fb47ffefcd2da28f091aa2ce"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "The teacher retired. O-nami sat in meditation trying to imagine himself as waves. He thought of many different things."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_398 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_227,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_355,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_391,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_393,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_399,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_400,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_401,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_402,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_403,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_90 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "8. Great Waves"^^xsd:string ;
    neo:id "318500aefac3c8695b02c0071e2ec13e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "Then gradually he turned more and more to the feelings of the waves. As the night advanced the waves became larger and larger. They swept away the flowers in their vases. Even the Buddha in the shrine was inundated. Before dawn the temple was nothing but the ebb and flow of an immense sea."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_404 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_178,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_381,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_405 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "8. Great Waves"^^xsd:string ;
    neo:id "3936292bf49a45f49bf2fb86b2880624"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "In the morning the teacher found O-nami meditating, a faint smile on his face. He patted the wrestlers shoulder. 'Now nothing can disturb you.' he said. 'You are the waves. You will sweep everything before you.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_406 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_22,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_381,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_407 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "8. Great Waves"^^xsd:string ;
    neo:id "a9f61e1999ccc2e4f2a6ffab3a53698a"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "The same day O-nami entered the wrestling contests and won. After that, no one in Japan was able to defeat him."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_408 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_267,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_341,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_409,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_410,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_411 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "9. The Moon cannot be Stolen"^^xsd:string ;
    neo:id "903c493ae5de21f080c4d7d2bc048902"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Ryokan, a Zen master, lived the simplest kind of life in a little hut at the foot of a mountain. One evening a thief visited the hut only to discover there was nothing in it to stea1."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_412 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_409,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_413,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_414 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "9. The Moon cannot be Stolen"^^xsd:string ;
    neo:id "578f5cb789b30c989a7bb6dd0db092e1"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Ryokan returned and caught him. 'You may have come a long way to visit me,' he told the prowler, 'and you should not return empty-handed. Please take my clothes as a gift.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_415 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_416,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_417,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_418 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "9. The Moon cannot be Stolen"^^xsd:string ;
    neo:id "3c2a80c67dca8d121c98e74ad6a27b2e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "The thief was bewildered. He took the clothes and slunk away."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_419 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_409,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_420 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "9. The Moon cannot be Stolen"^^xsd:string ;
    neo:id "d9f90240560bb629e60b21dca1644da3"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "Ryokan sat naked, watching the moon. 'Poor fellow,' he mused, 'I wish I could give him this beautiful moon.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_421 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_22,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_40,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_422,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_44 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "3bf137a900bc837283874631a569b105"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "The Zen master Hoshin lived in China many years. Then he returned to the northeastern part of Japan, where he taught his disciples. When he was getting very old, he told them a story he had heard in China."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_423 a neo:Document ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "6969577b18bcfe02f51bc8aa92366f49"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "This is the story:"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_424 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_425,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_426,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_44 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "50458f0e7af0c79bac790ac17a509c2d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "One year on the twenty-fifth of December, Tokufu, who was very old, said to his disciples: 'I am not going to-be alive next year so you fellows should treat me well this year.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_427 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_178,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_428,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_429,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_430 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "dc8a56fc25336387bd68cb0f425e5211"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "The pupils thought he was joking, but since he was a great-hearted teacher each of them in turn treated him to a feast on succeeding days of the departing year."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_431 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_425,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_432,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_433 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "33ed94ace2759901712c197f5c598e69"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "On the eve of the New Year, Tokufu concluded: 'You have been good to me. I shall leave you tomorrow afternoon when the snow has stopped.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_434 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_178,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_399,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_433,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_435,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_436,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_44 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "1cf16125df68af9b208814f2f9d7ae97"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "The disciples laughed, thinking he was aging and talking nonsense since the night was clear and without snow. But at midnight snow began to fall, and the next day they did not find their teacher about. They went to the meditation hall."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_437 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_355,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_438 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "d1b3acfef8439456c713bac06cc680f7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "There he had passed on."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_439 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_180,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_267,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_422,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_44 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "60f4d0e21cbbd964af2a28365b82d203"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "Hoshin, who related this story, told his disciples: 'It is not necessary for a Zen master to predict his passing, but if he really wishes to do so, he can.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_440 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_441,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_442 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "206878d0e56346a61183547babfdd02d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:text "'Can you?' someone asked."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_443 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_422 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "b120457d0f2fb1a76252c5fcd522cce7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:text "'Yes,' answered Hoshin. 'I will show you what I can do seven days from now.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_444 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_422,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_44,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_445 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "7550c9fa3f837ee2fe465b7c85e2669d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:text "None of the disciple's believed him, and most of them had even forgotten the conversation when Hoshin next called them together."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_446 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_261,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_355,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_447,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_448,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_449,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_450 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "2924305e3d351f047f047cf9b03ea91f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:text "'Seven days ago,' he remarked, 'I said I was going to leave you. It is customary to write a farewell poem, but I am neither poet nor calligrapher. Let one of you inscribe my last words.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_45 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_46,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_47,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_48,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_49 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "Foreword"^^xsd:string ;
    neo:id "5a8da6ee60768755acaf31f04b8af996"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "Dofuku said: 'In my opinion truth is beyond affirmation or negation, for this is the way it moves.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_451 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_328,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_355,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_452 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "e6e0f924da9dd40b67c94b3f785657a9"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 13 ;
    neo:text "His followers thought he was joking, but one of them started to write."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_453 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_422 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "7330fa4ffbd38f45e7273bd76b483a06"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 14 ;
    neo:text "'Are you ready?' Hoshin asked."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_454 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_455,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_456 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "78d586f859c24537c44012f4b79ed2d5"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 15 ;
    neo:text "'Yes, sir,' replied the writer."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_457 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_422 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "57cd636bc6d5e76df82c8020ac511387"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 16 ;
    neo:text "Then Hoshin dictated:"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_458 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_370,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_459 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "f140ff9e4aab6b4d47c9557283fb157e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 17 ;
    neo:text "I came from brilliancy And return to brilliancy."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_460 a neo:Document ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "efc45797ddd32ddad81371c29f3d549b"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 18 ;
    neo:text "What is this?"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_461 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_333,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_462,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_463,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_464 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "212c46c1b24d9312aaf5f9fff8efa2f7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 19 ;
    neo:text "The poem was one line short of the customary four, so, the disciple said: 'Master, we are one line short.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_465 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_422,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_466 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "10. The Last Poem of Hoshin"^^xsd:string ;
    neo:id "3ca276deabe73b6686dcfc884029b2a3"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 20 ;
    neo:text "Hoshin, with the roar of a conquering lion, shouted 'Kaa!' and was gone."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_467 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_468,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_469,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_470,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_471 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "9bc37e71c3cecd193795bdeef7661657"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "The exquisite Shunkai whose other name was Suzu was compelled to marry against her wishes when she was quite young. Later, after this marriage had ended, she attended the university, where she studied philosophy."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_472 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_295,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_391,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_468,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_470,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_471,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_473 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "e349edc443d792d65948da05385bd050"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "To see Shunkai was to fall in love with her. Moreover, wherever she went, she herself fell in love with others. Love was with her at the university, and afterwards, when philosophy did not satisfy her and she visited a temple to learn about Zen, the Zen students fell in love with her. Shunkai's whole life was saturated with love."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_474 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_241,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_275,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_475,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_476,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_477 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "83c3268fa675ea534ebe20276540f89d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "At last in Kyoto she became a real student of Zen. Her brothers in the sub-temple of Kennin praised her sincerity. One of them proved to be a congenial spirit and assisted her in the mastery of Zen."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_478 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_172,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_22,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_475,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_479,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_480,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_481,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_482 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "6b4e59e0aab75f5ebb79de806325d842"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "The abbot of Kennin, Mokurai, Silent Thunder, was severe. He kept the precepts himself and expected his priests to do so. In modern Japan whatever zeal these priests have lost for Buddhism they seem to have gained for having wives."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_483 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_171,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_479,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_484,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_485 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "b47e8eb20ab3c8ea7242342b29c680f8"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "Mokurai used to take a broom and chase the women away when he found them in any of his temples, but the more wives he swept out, the more seemed to come back."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_486 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_286,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_304,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_468,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_487,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_488,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_489 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "825514fcd25dd0c9bb0855d26b4dc202"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "In this particular temple the wife of the head priest became jealous of Shunkai's earnestness and beauty. Hearing the students praise her serious Zen made this wife squirm and itch. Finally she spread a rumor about Shunkai and the young man who was now her friend. As a consequence he was expelled and Shunkai was removed from the temple."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_490 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_304,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_468,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_473,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_491,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_492 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "63c5db7971c8b46b463824b6a30c4b3e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "'I may have made the mistake of love,' thought Shunkai, 'but the priest's wife shall not remain in the temple either if my friend is to be treated so unjustly.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_493 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_391,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_468,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_494,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_495 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "6068051bbec681f00be5d1368b2a6886"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "Shunkai the same night with a can of kerosene set fire to the five hundred year old temple and burned it to the ground. In the morning she found herself in the hands of the police."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_496 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_468,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_497,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_498,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_499 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "6a2378008e78222c1561de007416c2bc"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:text "A young lawyer became interested in her and endeavored to make her sentence lighter. 'Do not help me,' she told him. 'I might decide to do something else which would only imprison me again.' At last a sentence of seven years was completed, and Shunkai was released from the prison, where the sixty-three-year-old warden also had become enamored of her."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_50 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_39,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_51 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "Foreword"^^xsd:string ;
    neo:id "0cec4d22215acd2b9d5d3beb8edfcc90"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "Bodhidharma replied: 'You have my skin.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_500 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_213,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_468,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_501,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_502,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_503,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_504 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "9e53c03b55b4c3b165b5a23a79b890cd"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:text "But now everyone looked upon her as a 'jailbird'. No one would associate with her. Even the Zen people, who are supposed to believe in enlightenment in this life and with this body, shunned her. Zen, Shunkai found, was one thing and the followers of Zen quite another. Her relatives would have nothing to do with her. She grew sick, poor, and weak."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_505 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_468,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_506,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_507 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "4736a0db6e5b06ea43d3f26974d5a952"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:text "She met a Shinshu priest who taught her the name of the Buddha of Love, and in this Shunkai found some solace and peace of mind. She passed away when she was still exquisitely beautiful and hardly thirty years old."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_508 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_468,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_509,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_510 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "11. The Story of Shunkai"^^xsd:string ;
    neo:id "dfa114ac7e779f71c31d32c8bd23ddd9"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 12 ;
    neo:text "She wrote her own story in a futile endeavor to support herself and some of it she told to a woman writer. So it reached the Japanese people. Those who rejected Shunkai, those who slandered and hated her, now read of her life with tears of remorse."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_511 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_512,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_513,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_514,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_515,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_516,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_517 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "12. Happy Chinaman"^^xsd:string ;
    neo:id "6c7f1431b4789c464939fb14bf9d805f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Anyone walking about Chinatowns in America will observe statues of a stout fellow carrying a linen sack. Chinese merchants call him Happy Chinaman or Laughing Buddha."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_518 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_267,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_44,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_519,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_520,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_521,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_522,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_523,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_524,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_525,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_526,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_527 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "12. Happy Chinaman"^^xsd:string ;
    neo:id "27c614ac184a8cba4a777f03fe449e6e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "This Hotei lived in the T'ang dynasty. He had no desire to call himself a Zen master or to gather many disciples about him. Instead he walked the streets with a big sack into which he would put gifts of candy, fruit, or doughnuts. These he would give to children who gathered around him in play. He established a kindergarten of the streets."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_52 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_53,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_54,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_55 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "Foreword"^^xsd:string ;
    neo:id "a9831f329cf2a64c436f68504cba7502"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:text "The nun Soji said: 'In my view, it is like Ananda's sight of the Buddha- land--seen once and for ever.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_528 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_355,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_391,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_529,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_530,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_531 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "12. Happy Chinaman"^^xsd:string ;
    neo:id "1de82ca22a8e7a1941deae2ec946bf5d"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "Whenever he met a Zen devotee he would extend his hand and say: 'Give me one penny.' And if anyone asked him to return to a temple to teach others, again he would reply: 'Give me one penny.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_532 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_355,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_533 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "12. Happy Chinaman"^^xsd:string ;
    neo:id "90b006ef2a643b2ea1f4d802aa8203e2"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "Once as he was about his play work another Zen master happened along and inquired: 'What is the significance of Zen?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_534 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_519,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_522,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_535 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "12. Happy Chinaman"^^xsd:string ;
    neo:id "4f5f9846df78fc88ccdb768497b459e0"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "Hotei immediately plopped his sack down on the ground in silent answer."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_536 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_31,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_537,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_538 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "12. Happy Chinaman"^^xsd:string ;
    neo:id "0300076e06bfe0c04c7547f3e5cce617"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "'Then,' asked the other, 'what is the actualization of Zen?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_539 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_514,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_522 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "12. Happy Chinaman"^^xsd:string ;
    neo:id "400870dabfb89d910496b1272603ac2f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "At once the Happy Chinaman swung the sack over his shoulder and continued on his way."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_540 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_185,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_541,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_542,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_543,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_544,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_90 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "13. A Buddha"^^xsd:string ;
    neo:id "1b3c95be38d289921a71ef4da0690196"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "In Tokyo in the Meiji era there lived two prominent teachers of opposite characteristics. One, Unsho, an instructor in Shingon, kept Buddha's precepts scrupulously. He never drank intoxicants, nor did he eat after eleven o'clock in the morning."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_545 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_365,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_471,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_481,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_546 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "13. A Buddha"^^xsd:string ;
    neo:id "9955f26d3e26efa3b36c89e22484169a"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "The other teacher, Tanzan, a professor of philosophy at the Imperial University, never observed the precepts. When he felt like eating he ate, and when he felt like sleeping in the daytime he slept."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_547 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_226,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_365,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_542,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_548 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "13. A Buddha"^^xsd:string ;
    neo:id "0404e95aee5a752447ef68d39c2371d3"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "One day Unsho visited Tanzan, who was drinking wine at the time, not even a drop of which is supposed to touch the tongue of a Buddhist."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_549 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_365 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "13. A Buddha"^^xsd:string ;
    neo:id "d0fa1bda328f923d2888d8d9f14aa1af"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "'Hello, brother,' Tanzan greeted him. 'Won't you have a drink?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_551 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_542,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_552 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "13. A Buddha"^^xsd:string ;
    neo:id "bb08e64249f4f423166a2496cfab95c3"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "'I never drink!' exclaimed Unsho solemnly."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_553 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_365,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_554 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "13. A Buddha"^^xsd:string ;
    neo:id "9e493be615005438909ba4e8507b42cb"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "'One who does not drink is not even human,' said Tanzan."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_555 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_542,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_556,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_557,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_558 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "13. A Buddha"^^xsd:string ;
    neo:id "0867494e09e4363a8e25f978315aa3da"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "'Do you mean to call me inhuman just because I do not indulge in intoxicating liquids!' exclaimed Unsho in anger. Then if I am not human, what am I?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_559 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_365,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_90 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "13. A Buddha"^^xsd:string ;
    neo:id "912216dd7974d8c37c2a8d8751f8daf3"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "'A Buddha.' answered Tanzan."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_56 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_39 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "Foreword"^^xsd:string ;
    neo:id "3a275216106dbeee3819a11fe31e7ff1"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 10 ;
    neo:text "Bodhidharma answered: 'You have my flesh.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_560 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_206,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_365,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_561,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_562 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "14. Muddy Road"^^xsd:string ;
    neo:id "832b7953e4f8737f28ba05398e79a04b"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Tanzan and Ekido were once traveling together down a muddy road. A heavy rain was still falling."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_563 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_564,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_565,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_566,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_567,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_568,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_569 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "14. Muddy Road"^^xsd:string ;
    neo:id "2814cd1afcdae806daf1fbbce0af68e7"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Coming around a bend, they met a lovely girl in a silk kimono and sash, unable to cross the intersection."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_570 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_291,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_365,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_571 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "14. Muddy Road"^^xsd:string ;
    neo:id "f5e68cc34a836e740ddacb33c082a033"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "'Come on, girl,' said Tanzan at once. Lifting her in his arms, he carried her over the mud."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_572 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_561,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_573 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "14. Muddy Road"^^xsd:string ;
    neo:id "44548cbc47be7efa18897e24b76b220e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "Ekido did not speak again until that night when they reached a lodging temple. Then he no longer could restrain himself."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_574 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_340,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_365,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_575 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "14. Muddy Road"^^xsd:string ;
    neo:id "a1fe8a8fd2cd57515e116f37e4c26d82"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "'We monks don't go near females.' He told Tanzan, 'especially not young and lovely ones. It is dangerous. Why did you do that?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_576 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_346,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_365 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "14. Muddy Road"^^xsd:string ;
    neo:id "9b1e80589561b2cfc3f2cb280ddbcf34"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "'I left the girl there,' said Tanzan. 'Are you still carrying her?'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_577 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_578,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_579,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_580,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_581 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "15. Shoun and His Mother"^^xsd:string ;
    neo:id "1ca179ada5b533e387dabf67d2664568"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Shoun became a teacher of Soto Zen. When he was still a student his father passed away, leaving him to care for his old mother."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_58 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_46,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_59,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_60,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_61,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_62,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_63,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_64,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_65,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_66,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_67 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "Foreword"^^xsd:string ;
    neo:id "6064db087e8ec1cc33658bbf50b93947"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 11 ;
    neo:text "Dofuku said: 'The four elements of light, airiness, fluidity, and solidity are empty (i.e. inclusive) and the five skandas are No-things. In my opinion,"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_582 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_173,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_297,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_436,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_578,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_581,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_583,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_584,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_585,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_586,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_587 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "15. Shoun and His Mother"^^xsd:string ;
    neo:id "fbfd6f2698e7d73c37249736abade3ac"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "Whenever Shoun went to a meditation hall he always took his mother with him. Since she accompanied him, when he visited monasteries he could not live with the monks. So he would build a little house and care for her there. He would copy sutras, Buddhist verses and in this manner receive a few coins for food."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_588 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_232,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_340,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_578,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_581,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_589,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_590,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_591 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "15. Shoun and His Mother"^^xsd:string ;
    neo:id "e6d07026fb57075fe1df8dde237a6a2a"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 3 ;
    neo:text "When Shoun bought fish for his mother, the people would scoff at him, for a monk is not supposed to eat fish. But Shoun did not mind. His mother, however, was hurt to see others laugh at her son. Finally she told Shoun: 'I think I will become a nun. I can be a vegetarian too.'"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_592 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_275,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_578,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_581,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_593,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_594 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "15. Shoun and His Mother"^^xsd:string ;
    neo:id "005249fa6fd29262d0c10b2ee867e7fa"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 4 ;
    neo:text "She did and they studied together. Shoun was fond of music and was a master of the harp, which his mother also played."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_595 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_564,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_596 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "15. Shoun and His Mother"^^xsd:string ;
    neo:id "2598a22cb4e2a8cbd59fc98d1f74db1f"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 5 ;
    neo:text "On full-moon nights they used to play together."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_597 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_530,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_578,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_593,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_598,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_599,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_600 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "15. Shoun and His Mother"^^xsd:string ;
    neo:id "e0696a31024f79052aa76db8c12d2361"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 6 ;
    neo:text "One night a young lady passed by their house and heard music. Deeply touched, she invited Shoun to visit her the next evening and play. He accepted the invitation. A few days later he met the young lady on the street and thanked her for her hospitality. Others laughed at him. He had visited the home of a woman of the streets."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_601 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_289,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_335,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_578,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_602,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_603,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_604,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_605 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "15. Shoun and His Mother"^^xsd:string ;
    neo:id "9b58d70014339918638033d5de192936"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 7 ;
    neo:text "One day Shoun left a distant temple to deliver a lecture. A few months afterwards he returned home to find his mother dead. Friends had not known where to reach him, so the funeral was then in progress."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_606 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_289,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_578,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_607,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_608 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "15. Shoun and His Mother"^^xsd:string ;
    neo:id "6e239d09535c1a4547cb6fcf07432b82"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 8 ;
    neo:text "Shoun walked up and hit the coffin with his staff. 'Mother, your son has returned,' he said."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_609 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_289,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_610 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "15. Shoun and His Mother"^^xsd:string ;
    neo:id "5ff003c8e42481e3a9575971fa7b464e"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 9 ;
    neo:text "'I am glad to see you have returned son,' he answered for his mother."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_611 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_578,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_612,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_613,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_614 ;
