    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 121 ;
    neo:text "This consciousness exists as each being, and nothing else exists."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3559 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3560,
