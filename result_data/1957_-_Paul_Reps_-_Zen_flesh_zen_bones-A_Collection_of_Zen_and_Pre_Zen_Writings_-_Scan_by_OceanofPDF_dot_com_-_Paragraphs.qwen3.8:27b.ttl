        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_6 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "89. Zen Dialogue"^^xsd:string ;
    neo:id "bba417d349cdecfd52fe9fc853884e71"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Zen teachers train their young pupils to express themselves. Two Zen temples; each had a child protégé. One child going to obtain vegetables each morning would meet the other on the way."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1971 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1912,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1972 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "89. Zen Dialogue"^^xsd:string ;
    neo:id "5489be7732948deb39a39e0178b00ed0"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 2 ;
    neo:text "'Where are you going?' asked the one."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1973 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_537 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "89. Zen Dialogue"^^xsd:string ;
