        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3513,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3514 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "6a9606e79a63c552c21655bb885060be"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 109 ;
    neo:text "Suppose you are gradually being deprived of strength or of knowledge. At the instant of deprivation, transcend."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3515 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1322,
