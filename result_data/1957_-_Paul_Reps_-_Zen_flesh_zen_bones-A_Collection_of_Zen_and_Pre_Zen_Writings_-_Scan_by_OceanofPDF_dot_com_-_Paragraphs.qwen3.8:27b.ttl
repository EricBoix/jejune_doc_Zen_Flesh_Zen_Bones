        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3004,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_370 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "10 BULLS"^^xsd:string ;
    neo:h3 "2. Discovering the Footprints"^^xsd:string ;
    neo:id "a39aa69c41c577bca2fcc29febf32215"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Along the riverbank under the trees, I discover footprints! Even under the fragrant grass I see his prints. Deep in remote mountains they are found. These traces no more can be hidden than one's nose, looking"^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3005 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_1777,
