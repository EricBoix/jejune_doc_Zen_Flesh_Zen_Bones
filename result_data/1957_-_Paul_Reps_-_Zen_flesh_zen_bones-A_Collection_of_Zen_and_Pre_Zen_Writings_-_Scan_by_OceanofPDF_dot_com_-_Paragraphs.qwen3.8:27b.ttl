        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_267,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_325 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "101 ZEN STORIES"^^xsd:string ;
    neo:h3 "5. If You Love, Love Openly"^^xsd:string ;
    neo:id "9b1eba1f92be6ff5d1f2e36308c7f170"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 1 ;
    neo:text "Twenty monks and one nun, who was named Eshun, were practicing meditation with a certain Zen master."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3240 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3241,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3242,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3243,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3244,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3245,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3246,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3247,
        ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3248 ;
    neo:h1 "ZEN FLESH, ZEN BONES"^^xsd:string ;
    neo:h2 "CENTERING"^^xsd:string ;
    neo:id "34fecc1d1dc96f1e55de328d44b52222"^^xsd:string ;
    neo:jejune_source_name "1957_-_Paul_Reps_-_Zen_flesh_zen_bones-A_Collection_of_Zen_and_Pre_Zen_Writings_-_Scan_by_OceanofPDF_dot_com_-_local_converter.md"^^xsd:string ;
    neo:jejune_source_slug "zen-flesh-zen-bones"^^xsd:string ;
    neo:paragraph_number 36 ;
    neo:text "Bathe in the center of sound, as in the continuous sound of a waterfall. Or, by putting fingers in ears, hear the sound of sounds."^^xsd:string .

ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_3249 a neo:Document ;
    neo:MENTIONS ex:node_4_151b43f1_567f_4578_b41f_d18c5e861cad_261,
